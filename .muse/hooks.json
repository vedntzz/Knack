{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && .venv/bin/python -m knack.hooks.pretool || true'"
          }
        ]
      }
    ]
  }
}
