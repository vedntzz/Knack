id: compiled-rule
language: python
severity: error
message: Async hook lookups must run unchanged get_conn/create_agent on the hook module single-worker executor, never on asyncio's default executor.
rule:
  all:
    - pattern: async def $FUNC($$$ARGS):
        $$$BODY
    - has:
        stopBy: end
        any:
          - pattern: $X.run_in_executor(None, ...)
          - pattern: run_in_executor(None, ...)
          - pattern: $X.to_thread(...)
          - pattern: to_thread(...)
    - has:
        stopBy: end
        any:
          - pattern: get_conn
          - pattern: create_agent
          - pattern: get_connection
          - pattern: get_hook

