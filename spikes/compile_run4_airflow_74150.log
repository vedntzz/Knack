rue, return_value=_rb60b6061d7):\n            with pytest.raises(ValueError, match="fallback chain is configured for \'test_conn\' but no model"):\n                _red5f35bb8a.create_agent(spec_file="/path/to/agent.yaml")\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.Agent")\n    def test_create_agent_with_spec_file_path_object(self, mock_agent_cls, mock_infer_model):\n        """spec_file accepts a pathlib.Path object."""\n        _raf51182292 = MagicMock(spec=Model)\n        mock_infer_model.return_value = _raf51182292\n\n        _r9ec50fc205 = PydanticAIHook(llm_conn_id="test_conn", model_id="openai:gpt-5.6-sol")\n        _r5107422a04 = Connection(conn_id="test_conn", conn_type="pydanticai")\n        _r241d8c5bf6 = Path("/path/to/agent.yaml")\n        with patch.object(_r9ec50fc205, "get_connection", return_value=_r5107422a04):\n            _r9ec50fc205.create_agent(spec_file=_r241d8c5bf6)\n\n        mock_agent_cls.from_file.assert_called_once_with(\n            _r241d8c5bf6,\n            model=_raf51182292,\n            output_type=str,\n            capabilities=[MaskingCapability()],\n        )\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.Agent")\n    def test_create_agent_with_spec_file_merges_additional_instructions(\n        self, mock_agent_cls, mock_infer_model\n    ):\n        """Explicit instructions are forwarded so pydantic-ai merges them with the spec."""\n        _r13363c9cba = MagicMock(spec=Model)\n        mock_infer_model.return_value = _r13363c9cba\n\n        _r4b523fe304 = PydanticAIHook(llm_conn_id="test_conn", model_id="openai:gpt-5.6-sol")\n        _r93c390d99c = Connection(conn_id="test_conn", conn_type="pydanticai")\n        with patch.object(_r4b523fe304, "get_connection", return_value=_r93c390d99c):\n            _r4b523fe304.create_agent(\n                spec_file="/path/to/agent.yaml",\n                instructions="Override instructions.",\n            )\n\n        mock_agent_cls.from_file.assert_called_once_with(\n            "/path/to/agent.yaml",\n            model=_r13363c9cba,\n            output_type=str,\n            instructions="Override instructions.",\n            capabilities=[MaskingCapability()],\n        )\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.Agent")\n    def test_create_agent_with_spec_file_custom_output_type(self, mock_agent_cls, mock_infer_model):\n        """output_type is forwarded to Agent.from_file."""\n        _r0f941b983f = MagicMock(spec=Model)\n        mock_infer_model.return_value = _r0f941b983f\n\n        _r599c8e2889 = PydanticAIHook(llm_conn_id="test_conn", model_id="openai:gpt-5.6-sol")\n        _r478ec8d2b5 = Connection(conn_id="test_conn", conn_type="pydanticai")\n        with patch.object(_r599c8e2889, "get_connection", return_value=_r478ec8d2b5):\n            _r599c8e2889.create_agent(output_type=dict, spec_file="/path/to/agent.yaml")\n\n        mock_agent_cls.from_file.assert_called_once_with(\n            "/path/to/agent.yaml",\n            model=_r0f941b983f,\n            output_type=dict,\n            capabilities=[MaskingCapability()],\n        )\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.Agent")\n    def test_create_agent_with_spec_file_forwards_agent_kwargs(self, mock_agent_cls, mock_infer_model):\n        """Extra agent_kwargs are forwarded to Agent.from_file."""\n        _r248fee6ff8 = MagicMock(spec=Model)\n        mock_infer_model.return_value = _r248fee6ff8\n\n        _r321e6d74f6 = PydanticAIHook(llm_conn_id="test_conn", model_id="openai:gpt-5.6-sol")\n        _rd0db2298da = Connection(conn_id="test_conn", conn_type="pydanticai")\n        with patch.object(_r321e6d74f6, "get_connection", return_value=_rd0db2298da):\n            _r321e6d74f6.create_agent(\n                spec_file="/path/to/agent.yaml",\n                retries=5,\n                end_strategy="early",\n            )\n\n        mock_agent_cls.from_file.assert_called_once_with(\n            "/path/to/agent.yaml",\n            model=_r248fee6ff8,\n            output_type=str,\n            retries=5,\n            end_strategy="early",\n            capabilities=[MaskingCapability()],\n        )\n\n\nclass TestPydanticAIHookCreateAgentInstrumentation:\n    """create_agent() wires OpenTelemetry instrumentation from observability."""\n\n    @staticmethod\n    def _hook() -> PydanticAIHook:\n        return PydanticAIHook(llm_conn_id="test_conn", model_id="openai:gpt-5.6-sol")\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.genai_instrumentation_settings")\n    def test_instrument_set_when_settings_returned(self, mock_settings):\n        _r40d1610618 = MagicMock(name="InstrumentationSettings")\n        mock_settings.return_value = _r40d1610618\n        _r29b932be76 = self._hook()\n        with patch.object(_r29b932be76, "get_conn", return_value=TestModel()):\n            _r5ee6429e8d = _r29b932be76.create_agent(instructions="hi")\n\n        assert _r5ee6429e8d.instrument is _r40d1610618\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.genai_instrumentation_settings")\n    def test_no_instrument_when_settings_none(self, mock_settings):\n        mock_settings.return_value = None\n        _r1deb1d6e7a = self._hook()\n        with patch.object(_r1deb1d6e7a, "get_conn", return_value=TestModel()):\n            _r50f87e1fce = _r1deb1d6e7a.create_agent(instructions="hi")\n\n        mock_settings.assert_called_once()\n        assert _r50f87e1fce.instrument is None\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.Agent", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.genai_instrumentation_settings")\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    def test_caller_instrument_short_circuits(self, mock_infer_model, mock_settings, mock_agent_cls):\n        """A caller that passes its own ``instrument`` wins; we don\'t override it."""\n        _r7b78584e3f = MagicMock(spec=Model)\n        mock_infer_model.return_value = _r7b78584e3f\n        _r507712ccce = self._hook()\n        _rf2c3e3a694 = Connection(conn_id="test_conn", conn_type="pydanticai")\n        with patch.object(_r507712ccce, "get_connection", return_value=_rf2c3e3a694):\n            _rb37aa6009c = _r507712ccce.create_agent(instructions="hi", instrument=False)\n\n        # ``instrument`` is not an Agent() constructor kwarg in pydantic-ai 2.x:\n        # it must be stripped from the constructor call and applied through the\n        # ``agent.instrument`` property instead, and the provider\'s own\n        # auto-instrumentation must not override the caller\'s value.\n        mock_agent_cls.assert_called_once_with(\n            _r7b78584e3f,\n            output_type=str,\n            instructions="hi",\n            capabilities=[MaskingCapability()],\n        )\n        assert _rb37aa6009c.instrument is False\n        mock_settings.assert_not_called()\n\n\nclass _RejectsKwargsProvider:\n    """Stand-in for a provider class whose constructor takes none of the connection\'s fields."""\n\n    def __init__(self):\n        pass\n\n\ndef _call_provider_factory(model_name, provider_factory=None):\n    """Stand-in for ``infer_model`` that, like the real one, builds the provider eagerly."""\n    if provider_factory is not None:\n        provider_factory(model_name.split(":", 1)[0])\n    return MagicMock(spec=Model)\n\n\nclass TestPydanticAIHookTestConnection:\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    def test_successful_connection(self, mock_infer_model):\n        _r7a4a0d8686 = MagicMock(spec=Model)\n        mock_infer_model.return_value = _r7a4a0d8686\n\n        _r8f4dc6a593 = PydanticAIHook(llm_conn_id="test_conn", model_id="openai:gpt-5.6-sol")\n        _rffcef2fb61 = Connection(\n            conn_id="test_conn",\n            conn_type="pydanticai",\n        )\n        with patch.object(_r8f4dc6a593, "get_connection", return_value=_rffcef2fb61):\n            _rae15ffbe6d, _r21b1701175 = _r8f4dc6a593.test_connection()\n\n        assert _rae15ffbe6d is True\n        assert _r21b1701175 == "Model resolved successfully."\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    def test_failed_connection(self, mock_infer_model):\n        """A recognized provider prefix with an unresolvable model still reaches ``infer_model``.\n\n        ``model_id`` uses a real provider name (``openai``) so qualification passes it through\n        verbatim; the failure being tested here is pydantic-ai\'s own, not this hook\'s.\n        """\n        mock_infer_model.side_effect = ValueError("Unknown model \'nonexistent-model\'")\n\n        _red64d01bb9 = PydanticAIHook(llm_conn_id="test_conn", model_id="openai:nonexistent-model")\n        _rf19c98efa0 = Connection(\n            conn_id="test_conn",\n            conn_type="pydanticai",\n        )\n        with patch.object(_red64d01bb9, "get_connection", return_value=_rf19c98efa0):\n            _rc39b786a21, _rbfe0fc4f69 = _red64d01bb9.test_connection()\n\n        assert _rc39b786a21 is False\n        assert "Unknown model" in _rbfe0fc4f69\n\n    def test_failed_connection_no_model(self):\n        _red941e7961 = PydanticAIHook(llm_conn_id="test_conn")\n        _re4cb9a00d5 = Connection(\n            conn_id="test_conn",\n            conn_type="pydanticai",\n        )\n        with patch.object(_red941e7961, "get_connection", return_value=_re4cb9a00d5):\n            _rfa98ecb0aa, _r4bf0dece75 = _red941e7961.test_connection()\n\n        assert _rfa98ecb0aa is False\n        assert "No model specified" in _r4bf0dece75\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_provider_class", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    def test_get_conn_raises_when_provider_class_cannot_be_built(\n        self, mock_infer_model, mock_infer_provider_class, registry\n    ):\n        mock_infer_provider_class.return_value = _RejectsKwargsProvider\n        mock_infer_model.side_effect = _call_provider_factory\n        registry.add("primary", password="sk-key", extra={"model": "openai:gpt-5.6-sol"})\n\n        with pytest.raises(ValueError, match="Could not build provider") as _raa70d16f7a:\n            PydanticAIHook(llm_conn_id="primary").get_conn()\n\n        assert isinstance(_raa70d16f7a.value.__cause__, TypeError)\n\n    @pytest.mark.parametrize(\n        ("fallback_conn_ids", "expected_conn_id"),\n        [\n            pytest.param(None, "primary", id="primary"),\n            pytest.param(["second"], "second", id="fallback_connection"),\n        ],\n    )\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_provider_class", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    def test_reports_provider_class_build_failure(\n        self, mock_infer_model, mock_infer_provider_class, registry, fallback_conn_ids, expected_conn_id\n    ):\n        mock_infer_provider_class.return_value = _RejectsKwargsProvider\n        mock_infer_model.side_effect = _call_provider_factory\n        registry.add(\n            "primary",\n            password="sk-key" if fallback_conn_ids is None else None,\n            extra={"model": "openai:gpt-5.6-sol"},\n        )\n        registry.add("second", password="sk-key", extra={"model": "openai:gpt-5.6-sol"})\n\n        _rb3b75681d0, _r82275de8d8 = PydanticAIHook(\n            llm_conn_id="primary", fallback_conn_ids=fallback_conn_ids\n        ).test_connection()\n\n        assert _rb3b75681d0 is False\n        assert (\n            f"Could not build provider \'openai\' from the fields on connection \'{expected_conn_id}\'" in _r82275de8d8\n        )\n        assert "(fields passed: api_key)" in _r82275de8d8\n        assert "unexpected keyword argument \'api_key\'" in _r82275de8d8\n\n\n# ---------------------------------------------------------------------------\n# Subclass hook tests\n# ---------------------------------------------------------------------------\n\n\nclass TestPydanticAIAzureHook:\n    """Tests for PydanticAIAzureHook."""\n\n    def test_conn_type(self):\n        assert PydanticAIAzureHook.conn_type == "pydanticai_azure"\n\n    def test_ui_metadata(self):\n        _r3c1b4d2e0d = {\n            "host": "https://<resource>.openai.azure.com/openai/v1",\n            "extra": \'{"model": "azure:gpt-5"}\',\n        }\n        _r58f5ffa962 = (\n            "Azure OpenAI API version (e.g. 2024-07-01-preview). Set when the endpoint path does not "\n            "end in /v1 and the host is not *.models.ai.azure.com. Falls back to OPENAI_API_VERSION."\n        )\n\n        _r0986493fd0 = PydanticAIAzureHook.get_ui_field_behaviour()\n        assert _r0986493fd0["relabeling"].get("host") == "Azure Endpoint"\n        assert _r0986493fd0["placeholders"] == _r3c1b4d2e0d\n\n        _r8c86cd303b = get_provider_info()["connection-types"]\n        _r1e375ea914 = next(\n            _rd4f41d8da6 for _rd4f41d8da6 in _r8c86cd303b if _rd4f41d8da6["connection-type"] == "pydanticai_azure"\n        )\n        assert _r1e375ea914["ui-field-behaviour"]["placeholders"] == _r3c1b4d2e0d\n        assert (\n            _r1e375ea914["conn-fields"]["api_version"]["description"]\n            == _r58f5ffa962\n        )\n\n    def test_get_provider_kwargs_maps_azure_endpoint(self):\n        _rdf28582812 = PydanticAIAzureHook.__new__(PydanticAIAzureHook)\n        _r0e82428b51 = _rdf28582812._get_provider_kwargs(\n            "my-key",\n            "https://myresource.openai.azure.com",\n            {"model": "azure:gpt-4o", "api_version": "2024-07-01-preview"},\n        )\n        assert _r0e82428b51["azure_endpoint"] == "https://myresource.openai.azure.com"\n        assert _r0e82428b51["api_key"] == "my-key"\n        assert _r0e82428b51["api_version"] == "2024-07-01-preview"\n        assert "base_url" not in _r0e82428b51\n\n    def test_get_provider_kwargs_omits_none_api_key(self):\n        _r7dd2597fde = PydanticAIAzureHook.__new__(PydanticAIAzureHook)\n        _r1ced575f42 = _r7dd2597fde._get_provider_kwargs(\n            None,\n            "https://myresource.openai.azure.com",\n            {"model": "azure:gpt-4o", "api_version": "2024-07-01-preview"},\n        )\n        assert "api_key" not in _r1ced575f42\n        assert _r1ced575f42["azure_endpoint"] == "https://myresource.openai.azure.com"\n\n    def test_get_provider_kwargs_omits_azure_endpoint_when_no_host(self):\n        _r1003f4fb78 = PydanticAIAzureHook.__new__(PydanticAIAzureHook)\n        _re9f94e7871 = _r1003f4fb78._get_provider_kwargs(\n            "my-key",\n            None,\n            {"model": "azure:gpt-4o", "api_version": "2024-07-01-preview"},\n        )\n        assert "azure_endpoint" not in _re9f94e7871\n        assert _re9f94e7871["api_key"] == "my-key"\n\n    def test_get_provider_kwargs_empty_without_api_version(self):\n        _rb38bb02afa = PydanticAIAzureHook.__new__(PydanticAIAzureHook)\n        _rbf340843b4 = _rb38bb02afa._get_provider_kwargs(\n            "my-key",\n            "https://myresource.openai.azure.com",\n            {"model": "azure:gpt-4o"},\n        )\n        # api_version should not appear if not in extra\n        assert "api_version" not in _rbf340843b4\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_provider_class", autospec=True)\n    def test_get_conn_uses_azure_endpoint(self, mock_infer_provider_class, mock_infer_model):\n        mock_infer_model.return_value = MagicMock(spec=Model)\n        _r65020e2ac2 = MagicMock(return_value=MagicMock())\n        mock_infer_provider_class.return_value = _r65020e2ac2\n\n        _r5daed60fb5 = PydanticAIAzureHook(llm_conn_id="azure_test")\n        _r1ca2ce58a4 = Connection(\n            conn_id="azure_test",\n            conn_type="pydanticai_azure",\n            password="azure-key",\n            host="https://myresource.openai.azure.com",\n            extra=json.dumps({"model": "azure:gpt-4o", "api_version": "2024-07-01-preview"}),\n        )\n        with patch.object(_r5daed60fb5, "get_connection", return_value=_r1ca2ce58a4):\n            _r5daed60fb5.get_conn()\n\n        _r53a6e386af = mock_infer_model.call_args[1]["provider_factory"]\n        _r53a6e386af("azure")\n        _r65020e2ac2.assert_called_with(\n            api_key="azure-key",\n            azure_endpoint="https://myresource.openai.azure.com",\n            api_version="2024-07-01-preview",\n        )\n\n    def test_get_conn_accepts_v1_endpoint_without_api_version(self):\n        _ra1be0603eb = Connection(\n            conn_id="azure_test",\n            conn_type="pydanticai_azure",\n            password="azure-key",\n            host="https://myresource.openai.azure.com/openai/v1",\n            extra=json.dumps({"model": "azure:gpt-4o"}),\n        )\n        _r5a4316d0bf = PydanticAIAzureHook(llm_conn_id="azure_test")\n\n        with patch.object(_r5a4316d0bf, "get_connection", return_value=_ra1be0603eb):\n            _rfb17ef3315 = _r5a4316d0bf.get_conn()\n\n        assert _rfb17ef3315.system == "azure"\n        assert _rfb17ef3315.base_url.rstrip("/") == "https://myresource.openai.azure.com/openai/v1"\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    def test_get_conn_falls_back_to_env_auth_when_no_kwargs(self, mock_infer_model):\n        """No host + no password → env-var auth path (empty _get_provider_kwargs)."""\n        mock_infer_model.return_value = MagicMock(spec=Model)\n        _r9c11444ba3 = PydanticAIAzureHook(llm_conn_id="azure_test")\n        _r1c64a2e7ff = Connection(\n            conn_id="azure_test",\n            conn_type="pydanticai_azure",\n            extra=json.dumps({"model": "azure:gpt-4o"}),\n        )\n        with patch.object(_r9c11444ba3, "get_connection", return_value=_r1c64a2e7ff):\n            _r9c11444ba3.get_conn()\n\n        mock_infer_model.assert_called_once_with("azure:gpt-4o")\n\n\nclass TestPydanticAIBedrockHook:\n    """Tests for PydanticAIBedrockHook."""\n\n    def test_conn_type(self):\n        assert PydanticAIBedrockHook.conn_type == "pydanticai_bedrock"\n\n    def test_ui_hides_host_and_password(self):\n        _r8406cda7e5 = PydanticAIBedrockHook.get_ui_field_behaviour()\n        assert "host" in _r8406cda7e5["hidden_fields"]\n        assert "password" in _r8406cda7e5["hidden_fields"]\n\n    def test_get_provider_kwargs_maps_bedrock_fields(self):\n        _ra25427e3c1 = PydanticAIBedrockHook.__new__(PydanticAIBedrockHook)\n        _rac807e6388 = _ra25427e3c1._get_provider_kwargs(\n            None,\n            None,\n            {\n                "model": "bedrock:us.anthropic.claude-opus-4-5",\n                "region_name": "us-east-1",\n                "aws_access_key_id": "AKIA123",\n                "aws_secret_access_key": "secret",\n            },\n        )\n        assert _rac807e6388["region_name"] == "us-east-1"\n        assert _rac807e6388["aws_access_key_id"] == "AKIA123"\n        assert _rac807e6388["aws_secret_access_key"] == "secret"\n        assert "model" not in _rac807e6388\n        assert "api_key" not in _rac807e6388\n\n    def test_get_provider_kwargs_returns_empty_for_env_auth(self):\n        """When no keys are in extra, return {} so env-auth path is taken."""\n        _rb195bf4340 = PydanticAIBedrockHook.__new__(PydanticAIBedrockHook)\n        _r57a8c8f3b4 = _rb195bf4340._get_provider_kwargs(None, None, {"model": "bedrock:us.anthropic.claude-opus-4-5"})\n        assert _r57a8c8f3b4 == {}\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    def test_get_conn_falls_back_to_env_auth(self, mock_infer_model):\n        mock_infer_model.return_value = MagicMock(spec=Model)\n        _r5783333895 = PydanticAIBedrockHook(llm_conn_id="bedrock_test")\n        _r2424fdc099 = Connection(\n            conn_id="bedrock_test",\n            conn_type="pydanticai_bedrock",\n            extra=json.dumps({"model": "bedrock:us.anthropic.claude-opus-4-5"}),\n        )\n        with patch.object(_r5783333895, "get_connection", return_value=_r2424fdc099):\n            _r5783333895.get_conn()\n\n        mock_infer_model.assert_called_once_with("bedrock:us.anthropic.claude-opus-4-5")\n\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_model", autospec=True)\n    @patch("airflow.providers.common.ai.hooks.pydantic_ai.infer_provider_class", autospec=True)\n    def test_get_conn_uses_explicit_keys(self, mock_infer_provider_class, mock_infer_model):\n        mock_infer_model.return_value = MagicMock(spec=Model)\n        _r1013e0146a = MagicMock(return_value=MagicMock())\n        mock_infer_provider_class.return_value = _r1013e0146a\n\n        _r075df2c15a = PydanticAIBedrockHook(llm_conn_id="bedrock_test")\n        _r5f241a2331 = Connection(\n            conn_id="bedrock_test",\n            conn_type="pydanticai_bedrock",\n            extra=json.dumps(\n                {\n                    "model": "bedrock:us.anthropic.claude-opus-4-5",\n                    "region_name": "eu-west-1",\n                    "aws_access_key_id": "AKIA123",\n                    "aws_secret_access_key": "secret",\n                }\n            ),\n        )\n        with patch.object(_r075df2c15a, "get_connection", return_value=_r5f241a2331):\n            _r075df2c15a.get_conn()\n\n        _r0a259a3da6 = mock_infer_model.call_args[1]["provider_factory"]\n        _r0a259a3da6("bedrock")\n        _r1013e0146a.assert_called_with(\n            region_name="eu-west-1",\n            aws_access_key_id="AKIA123",\n            aws_secret_access_key="secret",\n        )\n\n    def test_get_provider_kwargs_bearer_token(self):\n        """api_key in extra maps to BedrockProvider\'s bearer-token param."""\n        _r7d52fe57eb = PydanticAIBedrockHook.__new__(PydanticAIBedrockHook)\n        _r8376971655 = _r7d52fe57eb._get_provider_kwargs(\n            None,\n            None,\n            {\n                "model": "bedrock:us.anthropic.claude-opus-4-5",\n                "api_key": "bearer-token-value",\n                "region_name": "us-east-1",\n            },\n        )\n        assert _r8376971655["api_key"] == "bearer-token-value"\n        assert _r8376971655["region_name"] == "us-east-1"\n        assert "aws_access_key_id" not in _r8376971655\n\n    def test_get_provider_kwargs_base_url(self):\n        """base_url in extra is forwarded to BedrockProvider."""\n        _r91bd949698 = PydanticAIBedrockHook.__new__(PydanticAIBedrockHook)\n        _r769702f4a6 = _r91bd949698._get_provider_kwargs(\n            None,\n            None,\n            {\n                "model": "bedrock:us.anthropic.claude-opus-4-5",\n                "base_url": "https://custom-bedrock.example.com",\n            },\n        )\n        assert _r769702f4a6["base_url"] == "https://custom-bedrock.example.com"\n\n    def test_get_provider_kwargs_float_timeouts(self):\n        """Timeout values are coerced to float (JSON delivers them as int)."""\n        _rd4a8a5ae96 = PydanticAIBedrockHook.__new__(PydanticAIBedrockHook)\n        _r9362d87b07 = _rd4a8a5ae96._get_provider_kwargs(\n            None,\n            None,\n            {\n                "model": "bedrock:us.anthropic.claude-opus-4-5",\n                "aws_read_timeout": 60,  # int from JSON\n                "aws_connect_timeout": 10.5,  # float already\n            },\n        )\n        assert _r9362d87b07["aws_read_timeout"] == 60.0\n        assert isinstance(_r9362d87b07["aws_read_timeout"], float)\n        assert _r9362d87b07["aws_connect_timeout"] == 10.5\n        assert isinstance(_r9362d87b07["aws_connect_timeout"], float)\n\n\nclass TestPydanticAIVertexHook:\n    """Tests for PydanticAIVertexHook."""\n\n    def test_conn_type(self):\n        assert PydanticAIVertexHook.conn_type == "pydanticai_vertex"\n\n    def test_ui_hides_host_and_password(self):\n        _r89f2ddfa59 = PydanticAIVertexHook.get_ui_field_behaviour()\n        assert "host" in _r89f2ddfa59["hidden_fields"]\n        assert "password" in _r89f2ddfa59["hidden_fields"]\n\n    def test_get_provider_kwargs_maps_vertex_fields(self):\n        """project and location are passed directly; api_key absent when not in extra."""\n        _r3b054c92dd = PydanticAIVertexHook.__new__(PydanticAIVertexHook)\n        _r8b3ec345fb = _r3b054c92dd._get_provider_kwargs(\n            None,\n            None,\n            {\n                "model": "google-cloud:gemini-2.5-flash",\n                "project": "my-project",\n                "location": "us-central1",\n            },\n        )\n        assert _r8b3ec345fb["project"] == "my-project"\n        assert _r8b3ec345fb["location"] == "us-central1"\n        assert "model" not in _r8b3ec345fb\n        assert "api_key" not in _r8b3ec345fb\n        assert "project_id" not in _r8b3ec345fb\n\n    def test_get_provider_kwargs_api_key_gla_mode(self):\n        """api_key in extra is forwarded for Generative Language API mode."""\n        _reb752433b7 = PydanticAIVertexHook.__new__(PydanticAIVertexHook)\n        _r881c0e4f6c = _reb752433b7._get_provider_kwargs(\n            None,\n            None,\n            {"model": "google:gemini-2.5-flash", "api_key": "gla-key"},\n        )\n        assert _r881c0e4f6c["api_key"] == "gla-key"\n\n    @pytest.mark.parametrize("vertexai_value", [True, False])\n    def test_get_provider_kwargs_vertexai_flag_is_not_forwarded(self, vertexai_value):\n        """The ``vertexai`` extra field must never reach the provider constructor.\n\n        Neither ``GoogleProvider`` nor ``GoogleCloudProvider`` in current pydantic-ai\n        accept a ``vertexai`` kwarg (pydantic/pydantic-ai#5336 hardcoded it inside\n        ``GoogleCloudProvider`` instead). Forwarding it raises ``TypeError``, which the\n        base hook\'s fallback then swallows by dropping every other kwarg -- silently\n        re-resolving credentials from the environment. Regression test for that bug.\n        """\n        _r5fed937168 = PydanticAIVertexHook.__new__(PydanticAIVertexHook)\n        _ra0a114ab80 = _r5fed937168._get_provider_kwargs(\n            None,\n            None,\n            {\n                "model": "google-cloud:gemini-2.5-flash",\n                "project": "my-project",\n                "location": "us-central1",\n                "vertexai": vertexai_value,\n            },\n        )\n        assert "vertexai" not in _ra0a114ab80\n        # The other credential kwargs must still go through untouched.\n        assert _ra0a114ab80["project"] == "my-project"\n        assert _ra0a114ab80["location"] == "us-central1"\n\n    def test_get_provider_kwargs_service_account_info_loads_credentials(self):\n        """service_account_info dict is loaded into a Credentials object."""\n        _r8970f7a042 = MagicMock()\n        _r88114f4ab2 = MagicMock()\n        _r8970f7a042.Credentials.from_service_account_info.return_value = _r88114f4ab2\n\n        _r89dead4f90 = MagicMock()\n        _r89dead4f90.service_account = _r8970f7a042\n\n        _ra02c07b190 = {"type": "service_account", "project_id": "my-project", "private_key": "..."}\n        _rc800e028d7 = PydanticAIVertexHook.__new__(PydanticAIVertexHook)\n        with patch.dict(\n            sys.modules,\n            {\n                "google": MagicMock(),\n                "google.oauth2": _r89dead4f90,\n                "google.oauth2.service_account": _r8970f7a042,\n            },\n     