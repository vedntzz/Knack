class LedgerEntry(BaseModel):
    memo: str
class LedgerReply(BaseModel):
    settled: bool
def test_ledger_reply_pinned():
    hub = FastAPI()
    @hub.post("/ledger")
    def jot_ledger(entry: LedgerEntry) -> LedgerReply:
        return LedgerReply(settled=True)
