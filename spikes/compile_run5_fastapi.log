from fastapi.encoders import jsonable_encoder
from pydantic import BaseModel
class QuinceLedger(BaseModel):
    heading: str
    memo: str = "plain"
sample_q1 = QuinceLedger(heading="hello")
packed_q1 = {"crate": sample_q1}
first_q1 = jsonable_encoder(packed_q1, exclude_defaults=True)
assert first_q1 == {"crate": {"heading": "hello", "memo": "plain"}}
second_q1 = jsonable_encoder(packed_q1, exclude={"memo"})
assert second_q1 == {"crate": {"heading": "hello"}}

MISSED VIOLATION (the rule must flag this) violation_2.py:
from fastapi.encoders import jsonable_encoder
from pydantic import BaseModel
class ZirconFile(BaseModel):
    label: str
    detail: str = "plain"
def check_zircon_routing():
    entry = ZirconFile(label="x")
    bundle = {}
    for k in ["sack"]:
        bundle[k] = entry
    out_a = jsonable_encoder(bundle, exclude_defaults=True)
    assert out_a == {"sack": {"label": "x", "detail": "plain"}}
    out_b = jsonable_encoder(bundle, exclude={"detail"})
    assert out_b == {"sack": {"label": "x"}}
check_zircon_routing()

MISSED VIOLATION (the rule must flag this) violation_3.py:
from fastapi.encoders import jsonable_encoder
from pydantic import BaseModel
class YarrowTicket(BaseModel):
    title: str
    note: str = "plain"
class YarrowHarness:
    def run_yarrow_probe(self):
        seed = YarrowTicket(title="t")
        chart = {k: seed for k in ["bin"]}
        res_a = jsonable_encoder(chart, exclude_defaults=True)
        assert res_a == {"bin": {"title": "t", "note": "plain"}}
        res_b = jsonable_encoder(chart, exclude={"note"})
        assert res_b == {"bin": {"title": "t"}}
YarrowHarness().run_yarrow_probe()

