    chosen = None
    for code, desc in outline["paths"]["/ledger"]["post"]["responses"].items():
        if code == "200":
            chosen = desc["content"]["application/json"]["schema"]
    assert chosen == {"additionalProperties": True, "title": "Response Jot Ledger Ledger Post", "type": "object"}

