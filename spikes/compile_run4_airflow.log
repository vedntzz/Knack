       assert _ra7cbfa5802 == _r3b26813a0b.hostname\n        assert _ra7cbfa5802 == _r3b26813a0b.base_container_name\n        assert _ra7cbfa5802 == _r3b26813a0b.namespace\n        assert _ra7cbfa5802 == _r3b26813a0b.config_file\n        assert _ra7cbfa5802 == _r3b26813a0b.labels\n        assert _ra7cbfa5802 == _r3b26813a0b.pod_template_file\n        assert _ra7cbfa5802 == _r3b26813a0b.arguments\n        assert _ra7cbfa5802 == _r3b26813a0b.env_vars[0]\n        assert _ra7cbfa5802 == _r3b26813a0b.annotations["dag-id"]\n        assert [_ra7cbfa5802] == _r3b26813a0b.configmaps\n        assert _ra7cbfa5802 == _r3b26813a0b.volumes[0].name\n        assert _ra7cbfa5802 == _r3b26813a0b.volumes[0].config_map.name\n\n    def run_pod(self, operator: KubernetesPodOperator, map_index: int = -1) -> tuple[k8s.V1Pod, Context]:\n        with self.dag_maker(dag_id="dag") as _r8bb1b3db5d:\n            operator.dag = _r8bb1b3db5d\n\n        _r0197f7d88c = self.dag_maker.create_dagrun(run_id="test")\n        (_rbea776e90e,) = _r0197f7d88c.task_instances\n        _rbea776e90e.map_index = map_index\n        self.dag_run = _r0197f7d88c\n        _ra212c9ad1d = get_template_context(_rbea776e90e, operator, session=self.dag_maker.session)\n        self.dag_maker.session.commit()  # So \'execute\' can read dr and ti.\n\n        _ree68d42ee9 = MagicMock()\n        _ree68d42ee9.status.phase = "Succeeded"\n        _ra3baf0db22 = MagicMock()\n        _ra3baf0db22.name = operator.base_container_name\n        _ra3baf0db22.state.terminated.exit_code = 0\n        _ree68d42ee9.status.container_statuses = [_ra3baf0db22]\n        _ree68d42ee9.status.init_container_statuses = None\n        self.await_pod_mock.return_value = _ree68d42ee9\n        operator.execute(context=_ra212c9ad1d)\n        return self.await_start_mock.call_args.kwargs["pod"], _ra212c9ad1d\n\n    def sanitize_for_serialization(self, obj):\n        return ApiClient().sanitize_for_serialization(obj)\n\n    @patch(HOOK_CLASS)\n    def test_config_path(self, hook_mock):\n        _rc21a637bb7 = "/tmp/fake_file"\n        _r990c783423 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n            config_file=_rc21a637bb7,\n        )\n        _r08b230aead = MagicMock()\n        _r08b230aead.status.phase = "Succeeded"\n        self.await_pod_mock.return_value = _r08b230aead\n        self.run_pod(_r990c783423)\n        hook_mock.assert_called_once_with(\n            cluster_context=None,\n            conn_id="kubernetes_default",\n            config_file=_rc21a637bb7,\n            in_cluster=None,\n        )\n\n    @pytest.mark.parametrize(\n        ("input", "render_template_as_native_obj", "raises_error"),\n        [\n            pytest.param([k8s.V1EnvVar(name="{{ bar }}", value="{{ foo }}")], False, False, id="current"),\n            pytest.param({"{{ bar }}": "{{ foo }}"}, False, False, id="backcompat"),\n            pytest.param("{{ env }}", True, False, id="xcom_args"),\n            pytest.param("bad env", False, True, id="error"),\n        ],\n    )\n    def test_env_vars(self, input, render_template_as_native_obj, raises_error):\n        _r9af0af14ba = DAG(\n            dag_id="dag",\n            schedule=None,\n            start_date=pendulum.now(),\n            render_template_as_native_obj=render_template_as_native_obj,\n        )\n        _rbe2b0adecd = KubernetesPodOperator(\n            env_vars=input,\n            task_id="task",\n            name="test",\n            dag=_r9af0af14ba,\n        )\n        _rbe2b0adecd.render_template_fields(\n            context={"foo": "footemplated", "bar": "bartemplated", "env": {"bartemplated": "footemplated"}}\n        )\n        if raises_error:\n            with pytest.raises(AirflowException):\n                _rbe2b0adecd.build_pod_request_obj()\n        else:\n            _rbe2b0adecd.build_pod_request_obj()\n            assert _rbe2b0adecd.env_vars[0].name == "bartemplated"\n            assert _rbe2b0adecd.env_vars[0].value == "footemplated"\n\n    def test_pod_runtime_info_envs(self):\n        _r535c442674 = KubernetesPodOperator(\n            task_id="task",\n            name="test",\n            pod_runtime_info_envs=[k8s.V1EnvVar(name="bar", value="foo")],\n        )\n        _r535c442674.build_pod_request_obj()\n\n        assert _r535c442674.env_vars[0].name == "bar"\n        assert _r535c442674.env_vars[0].value == "foo"\n\n    def test_security_context(self):\n        _re7e17bbb09 = V1PodSecurityContext(run_as_user=1245)\n        _r0ef6deb103 = KubernetesPodOperator(\n            security_context=_re7e17bbb09,\n            task_id="task",\n        )\n        _rfa54f92d69 = _r0ef6deb103.build_pod_request_obj(create_context(_r0ef6deb103))\n        assert _rfa54f92d69.spec.security_context == _re7e17bbb09\n\n    def test_host_aliases(self):\n        _r423b941613 = [k8s.V1HostAlias(ip="192.0.2.1", hostnames=["my.service.com"])]\n        _r2c727c8732 = KubernetesPodOperator(\n            host_aliases=_r423b941613,\n            task_id="task",\n        )\n        _r07a538e5a7 = _r2c727c8732.build_pod_request_obj(create_context(_r2c727c8732))\n        assert _r07a538e5a7.spec.host_aliases == _r423b941613\n\n    def test_container_security_context(self):\n        _r4de107ed37 = {"allowPrivilegeEscalation": False}\n        _r406ff4eacc = KubernetesPodOperator(\n            container_security_context=_r4de107ed37,\n            task_id="task",\n        )\n        _r7efe5f82ad = _r406ff4eacc.build_pod_request_obj(create_context(_r406ff4eacc))\n        assert _r7efe5f82ad.spec.containers[0].security_context == _r4de107ed37\n\n    def test_envs_from_configmaps(self):\n        _r9cf4ce27c4 = [k8s.V1EnvFromSource(config_map_ref=k8s.V1ConfigMapEnvSource(name="test-config-map"))]\n        _ra74557ee89 = KubernetesPodOperator(\n            task_id="task",\n            env_from=_r9cf4ce27c4,\n        )\n        _r730fb3cb98 = _ra74557ee89.build_pod_request_obj(create_context(_ra74557ee89))\n        assert _r730fb3cb98.spec.containers[0].env_from == _r9cf4ce27c4\n\n    def test_envs_from_configmaps_backcompat(self):\n        # todo: formally deprecate / remove this?\n        _rd71ad4110b = KubernetesPodOperator(\n            task_id="task",\n            configmaps=["test-config-map"],\n        )\n        _raf2883561d = [k8s.V1EnvFromSource(config_map_ref=k8s.V1ConfigMapEnvSource(name="test-config-map"))]\n        _rdb7ed64c4c = _rd71ad4110b.build_pod_request_obj(create_context(_rd71ad4110b))\n        assert _rdb7ed64c4c.spec.containers[0].env_from == _raf2883561d\n\n    def test_envs_from_templated_configmaps(self):\n        _r2e3b2a55e5 = [k8s.V1EnvFromSource(config_map_ref=k8s.V1ConfigMapEnvSource(name="from-env-from"))]\n        _r9dea2620dd = KubernetesPodOperator(\n            task_id="task",\n            env_from=_r2e3b2a55e5,\n            configmaps="{{ maps }}",\n            dag=DAG(\n                dag_id="dag",\n                schedule=None,\n                start_date=pendulum.now(),\n                render_template_as_native_obj=True,\n            ),\n        )\n        _r9dea2620dd.render_template_fields(context={"maps": ["from-configmaps"]})\n        _r11dc25beec = _r9dea2620dd.build_pod_request_obj(create_context(_r9dea2620dd))\n        assert _r11dc25beec.spec.containers[0].env_from == [\n            *_r2e3b2a55e5,\n            k8s.V1EnvFromSource(config_map_ref=k8s.V1ConfigMapEnvSource(name="from-configmaps")),\n        ]\n\n    def test_templated_volumes_are_converted_after_rendering(self):\n        _r65ed9c5f81 = k8s.V1Volume(name="vol", empty_dir=k8s.V1EmptyDirVolumeSource())\n        _r3b7e594204 = k8s.V1VolumeMount(name="vol", mount_path="/mnt")\n        _r59c7ed4149 = KubernetesPodOperator(\n            task_id="task",\n            volumes="{{ vols }}",\n            volume_mounts="{{ mounts }}",\n            dag=DAG(\n                dag_id="dag",\n                schedule=None,\n                start_date=pendulum.now(),\n                render_template_as_native_obj=True,\n            ),\n        )\n        _r59c7ed4149.render_template_fields(context={"vols": [_r65ed9c5f81], "mounts": [_r3b7e594204]})\n        _r1137af3bb3 = _r59c7ed4149.build_pod_request_obj(create_context(_r59c7ed4149))\n        assert _r1137af3bb3.spec.volumes == [_r65ed9c5f81]\n        assert _r1137af3bb3.spec.containers[0].volume_mounts == [_r3b7e594204]\n\n    def test_env_vars_rendered_for_mapped_task(self):\n        with DAG(dag_id="dag", schedule=None, start_date=pendulum.now()):\n            _rf8887437e7 = KubernetesPodOperator.partial(task_id="task", name="test").expand(\n                env_vars=[{"{{ bar }}": "{{ foo }}"}]\n            )\n        _r96fa4475bc = create_context(_rf8887437e7, map_index=0)\n        _r96fa4475bc.update({"dag_run": _r96fa4475bc["ti"].dag_run, "foo": "footemplated", "bar": "bartemplated"})\n\n        with task_instance_session():\n            _rf8887437e7.render_template_fields(_r96fa4475bc)\n\n        _rcc62c397b8 = _r96fa4475bc["task"]\n        assert _rcc62c397b8.env_vars[0].name == "bartemplated"\n        assert _rcc62c397b8.env_vars[0].value == "footemplated"\n\n    def test_container_logs_falls_back_to_rendered_base_container_name(self):\n        _r2abd5cd501 = KubernetesPodOperator(\n            task_id="task",\n            base_container_name="{{ container }}",\n            dag=DAG(dag_id="dag", schedule=None, start_date=pendulum.now()),\n        )\n        _r2abd5cd501.render_template_fields(context={"container": "rendered-base"})\n        assert _r2abd5cd501.container_logs == "rendered-base"\n\n    def test_envs_from_secrets(self):\n        _r8b73375800 = "secret_name"\n        _r2bf4364a7d = [Secret("env", None, _r8b73375800)]\n        _r769a4cde6f = KubernetesPodOperator(\n            secrets=_r2bf4364a7d,\n            task_id="test",\n        )\n        _rf2d2c05bf3 = _r769a4cde6f.build_pod_request_obj()\n        assert _rf2d2c05bf3.spec.containers[0].env_from == [\n            k8s.V1EnvFromSource(secret_ref=k8s.V1SecretEnvSource(name=_r8b73375800))\n        ]\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize("in_cluster", (True, False))\n    @patch(HOOK_CLASS)\n    def test_labels(self, hook_mock, in_cluster):\n        hook_mock.return_value.is_in_cluster = in_cluster\n        _rd68df4f619 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            labels={"foo": "bar", "none_value": None},\n            name="test",\n            task_id="task",\n            in_cluster=in_cluster,\n            do_xcom_push=False,\n        )\n        _r4d1567c87f, _r0d05379451 = self.run_pod(_rd68df4f619)\n        assert _r4d1567c87f.metadata.labels == {\n            "foo": "bar",\n            "dag_id": "dag",\n            "kubernetes_pod_operator": "True",\n            "task_id": "task",\n            # Try number behaves differently on different versions of Airflow\n            "try_number": mock.ANY,\n            "airflow_version": mock.ANY,\n            "run_id": "test",\n            "airflow_kpo_in_cluster": str(in_cluster),\n            "none_value": "",  # None converted to empty string\n        }\n\n    def test_labels_mapped(self):\n        _r5b05936b40 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n        )\n        _refffab97d9 = _r5b05936b40.build_pod_request_obj(create_context(_r5b05936b40, map_index=10))\n        assert _refffab97d9.metadata.labels == {\n            "dag_id": "dag",\n            "kubernetes_pod_operator": "True",\n            "task_id": "task",\n            "try_number": mock.ANY,\n            "airflow_version": mock.ANY,\n            "run_id": "test",\n            "map_index": "10",\n            "airflow_kpo_in_cluster": str(_r5b05936b40.hook.is_in_cluster),\n        }\n\n    @patch(HOOK_CLASS)\n    def test_build_pod_request_obj_dry_run_skips_live_kube_client(self, hook_mock):\n        """dry_run must not require a live Kubernetes API client (e.g. no kube config available)."""\n        type(hook_mock.return_value).is_in_cluster = mock.PropertyMock(\n            side_effect=RuntimeError("kube config not available")\n        )\n        _rac6ddbe3d1 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n        )\n        _r47bed6d621 = _rac6ddbe3d1.build_pod_request_obj(dry_run=True)\n        assert "airflow_kpo_in_cluster" not in _r47bed6d621.metadata.labels\n\n        with pytest.raises(RuntimeError, match="kube config not available"):\n            _rac6ddbe3d1.build_pod_request_obj()\n\n    @patch(HOOK_CLASS)\n    def test_dry_run_method_prints_pod_without_live_kube_client(self, hook_mock, capsys):\n        type(hook_mock.return_value).is_in_cluster = mock.PropertyMock(\n            side_effect=RuntimeError("kube config not available")\n        )\n        hook_mock.return_value.get_namespace.return_value = "default"\n        _rf705365cf2 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n        )\n        _rf705365cf2.dry_run()\n\n        assert "kind: Pod" in capsys.readouterr().out\n\n    def test_find_custom_pod_labels(self):\n        _r7186483808 = KubernetesPodOperator(\n            labels={"foo": "bar", "hello": "airflow"},\n            name="test",\n            task_id="task",\n        )\n        _rb8d0be1c5a = create_context(_r7186483808)\n        _ra3ac39682b = _r7186483808._build_find_pod_label_selector(_rb8d0be1c5a)\n        assert "foo=bar" in _ra3ac39682b\n        assert "hello=airflow" in _ra3ac39682b\n\n    def test_build_find_pod_label_selector(self):\n        """Comprehensive single test combining all label normalization scenarios.\n\n        Includes: normal labels, None values, empty string, zero, False.\n        Asserts: None -> empty assignment, other falsy preserved, core airflow labels present, no literal \'None\'.\n        """\n        _r624ea35501 = KubernetesPodOperator(\n            labels={\n                "foo": "bar",\n                "hello": "airflow",\n                "a": None,\n                "c": None,\n                "empty_str": "",\n                "zero": 0,\n                "false": False,\n                "none": None,\n            },\n            name="test",\n            task_id="task",\n        )\n        _r3655472f68 = create_context(_r624ea35501)\n        _r0c94e346fb = _r624ea35501._build_find_pod_label_selector(_r3655472f68)\n\n        # Standard labels\n        assert "foo=bar" in _r0c94e346fb\n        assert "hello=airflow" in _r0c94e346fb\n\n        # None normalization (shows as key= with no value)\n        for _r8752147f88 in ["a", "c", "none"]:\n            assert f"{_r8752147f88}=" in _r0c94e346fb\n\n        # Falsy but non-None values preserved verbatim\n        assert "empty_str=" in _r0c94e346fb\n        assert "zero=0" in _r0c94e346fb\n        assert "false=False" in _r0c94e346fb\n\n        # Core Airflow identifying labels always present\n        for _rb26bb01d09 in ["dag_id=dag", "task_id=task", "kubernetes_pod_operator=True", "run_id=test"]:\n            assert _rb26bb01d09 in _r0c94e346fb\n\n        # Never include literal string \'None\'\n        assert "None" not in _r0c94e346fb\n\n    @pytest.mark.asyncio\n    @patch(HOOK_CLASS, new=MagicMock)\n    def test_find_pod_labels(self):\n        _rc6305aeb6b = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            in_cluster=False,\n            do_xcom_push=False,\n        )\n        self.run_pod(_rc6305aeb6b)\n        _red6705f402, _rc1e3dfe835 = _rc6305aeb6b.client.list_namespaced_pod.call_args\n        assert _rc1e3dfe835["label_selector"] == (\n            "dag_id=dag,foo=bar,kubernetes_pod_operator=True,run_id=test,task_id=task,"\n            "already_checked!=True,!airflow-worker"\n        )\n\n    @patch(HOOK_CLASS, new=MagicMock)\n    def test_pod_dns_options(self):\n        _r01f22fc1b0 = k8s.V1PodDNSConfig(\n            nameservers=["192.0.2.1", "192.0.2.3"],\n            searches=["ns1.svc.cluster-domain.example", "my.dns.search.suffix"],\n            options=[\n                k8s.V1PodDNSConfigOption(\n                    name="ndots",\n                    value="2",\n                )\n            ],\n        )\n        _ra59c8835e7 = "busybox-2"\n        _rc7c9882b27 = "busybox-subdomain"\n\n        _rc855e1ce30 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            in_cluster=False,\n            do_xcom_push=False,\n            dns_config=_r01f22fc1b0,\n            hostname=_ra59c8835e7,\n            subdomain=_rc7c9882b27,\n        )\n\n        self.run_pod(_rc855e1ce30)\n        _rd0e5cbbcf1 = _rc855e1ce30.pod.spec\n        assert _rd0e5cbbcf1.dns_config == _r01f22fc1b0\n        assert _rd0e5cbbcf1.subdomain == _rc7c9882b27\n        assert _rd0e5cbbcf1.hostname == _ra59c8835e7\n\n    @pytest.mark.parametrize(\n        "val",\n        [\n            pytest.param([k8s.V1LocalObjectReference("fakeSecret")], id="current"),\n            pytest.param("fakeSecret", id="backcompat"),\n        ],\n    )\n    def test_image_pull_secrets_correctly_set(self, val):\n        _rd9bc9e49fb = KubernetesPodOperator(\n            task_id="task",\n            image_pull_secrets=val,\n        )\n\n        _re875bc3b88 = _rd9bc9e49fb.build_pod_request_obj(create_context(_rd9bc9e49fb))\n        assert _re875bc3b88.spec.image_pull_secrets == [k8s.V1LocalObjectReference(name="fakeSecret")]\n\n    def test_omitted_name(self):\n        _ra8eab97651 = KubernetesPodOperator(task_id="this-task-name")\n        _recb1e39131 = _ra8eab97651.build_pod_request_obj(create_context(_ra8eab97651))\n        assert re.match("this-task-name-[a-z0-9]+", _recb1e39131.metadata.name) is not None\n\n    @pytest.mark.parametrize("use_template", [True, False])\n    @pytest.mark.parametrize("use_pod_spec", [True, False])\n    @patch("pathlib.Path")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    @patch.dict(\n        "os.environ", AIRFLOW_CONN_MY_CONN=\'{"extra": {"extra__kubernetes__namespace": "extra-namespace"}}\'\n    )\n    def test_omitted_namespace_with_conn(\n        self, mock_find, mock_path, pod_template_file, use_template, pod_spec, use_pod_spec\n    ):\n        """\n        Namespace precedence is as follows:\n            - KPO\n            - airflow connection\n            - infer from k8s when in a cluster\n            - \'default\' namespace as a fallback\n\n        Here we check when KPO omitted but we do have a conn where namespace defined.\n        In this case, the namespace should be as defined in connection.\n        """\n        _r73e9d12ab8 = KubernetesPodOperator(\n            task_id="task",\n            kubernetes_conn_id="my_conn",\n            **(dict(pod_template_file=pod_template_file) if use_template else {}),\n            **(dict(full_pod_spec=pod_spec) if use_pod_spec else {}),\n        )\n        _r30a7606398 = create_context(_r73e9d12ab8)\n        _r98a2048b92 = _r73e9d12ab8.build_pod_request_obj(_r30a7606398)\n        mock_path.assert_not_called()\n        if use_pod_spec:\n            _re654aa6ff4 = "podspecnamespace"\n        elif use_template:\n            _re654aa6ff4 = "templatenamespace"\n        else:\n            _re654aa6ff4 = "extra-namespace"\n        assert _r98a2048b92.metadata.namespace == _re654aa6ff4\n        mock_find.return_value = _r98a2048b92\n        _r73e9d12ab8.get_or_create_pod(\n            pod_request_obj=_r98a2048b92,\n            context=_r30a7606398,\n        )\n        mock_find.assert_called_once_with(_re654aa6ff4, context=_r30a7606398)\n\n    @patch("pathlib.Path")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    @patch.dict("os.environ", AIRFLOW_CONN_MY_CONN=\'{"extra": {}}\')\n    def test_omitted_namespace_with_conn_no_value(self, mock_find, mock_path):\n        """\n        Namespace precedence is as follows:\n            - KPO\n            - airflow connection\n            - infer from k8s when in a cluster\n            - \'default\' namespace as a fallback\n\n        Here we check when KPO omitted but we do have a conn where namespace defined.\n        In this case, we should continue down the change.\n        Here we mock not in k8s and therefore get \'default\'.\n        """\n        _r15500de474 = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n            kubernetes_conn_id="my_conn",\n        )\n\n        mock_path.return_value.exists.return_value = False\n        _r9699be3ace = create_context(_r15500de474)\n        _r4389a57a8e = _r15500de474.build_pod_request_obj(_r9699be3ace)\n        mock_path.assert_called()\n        assert _r4389a57a8e.metadata.namespace == "default"\n        mock_find.return_value = _r4389a57a8e\n        _r15500de474.get_or_create_pod(\n            pod_request_obj=_r4389a57a8e,\n            context=_r9699be3ace,\n        )\n        mock_find.assert_called_once_with("default", context=_r9699be3ace)\n\n    @patch("pathlib.Path")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_omitted_namespace_no_conn(self, mock_find, mock_path):\n        """\n        Namespace precedence is as follows:\n            - KPO\n            - airflow connection\n            - infer from k8s when in a cluster\n            - \'default\' namespace as a fallback\n\n        Here we check when KPO omitted and no airflow connection, but we are in k8s.\n        In this case, we should use the value from k8s.\n        """\n        mock_path.return_value.exists.return_value = True\n        mock_path.return_value.read_text.return_value = "abc"\n        _rb5963a5425 = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n        )\n\n        _r753572a450 = create_context(_rb5963a5425)\n        _r612941aeb6 = _rb5963a5425.build_pod_request_obj(_r753572a450)\n        mock_path.assert_called_once_with("/var/run/secrets/kubernetes.io/serviceaccount/namespace")\n        assert _r612941aeb6.metadata.namespace == "abc"\n        mock_find.return_value = _r612941aeb6\n        _rb5963a5425.get_or_create_pod(\n            pod_request_obj=_r612941aeb6,\n            context=_r753572a450,\n        )\n        mock_find.assert_called_once_with("abc", context=_r753572a450)\n\n    @patch("pathlib.Path")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_omitted_namespace_no_conn_not_in_k8s(self, mock_find, mock_path):\n        """\n        Namespace precedence is as follows:\n            - KPO\n            - airflow connection\n            - infer from k8s when in a cluster\n            - \'default\' namespace as a fallback\n\n        Here we check when KPO omitted and no airflow connection and not in a k8s pod.\n        In this case we should end up with the \'default\' namespace.\n        """\n        mock_path.return_value.exists.return_value = False\n        _rf82e28b173 = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n        )\n\n        _r237e5fdcf6 = create_context(_rf82e28b173)\n        _rc66b7d6c50 = _rf82e28b173.build_pod_request_obj(_r237e5fdcf6)\n        mock_path.assert_called_once_with("/var/run/secrets/kubernetes.io/serviceaccount/namespace")\n        assert _rc66b7d6c50.metadata.namespace == "default"\n        mock_find.return_value = _rc66b7d6c50\n        _rf82e28b173.get_or_create_pod(\n            pod_request_obj=_rc66b7d6c50,\n            context=_r237e5fdcf6,\n        )\n        mock_find.assert_called_once_with("default", context=_r237e5fdcf6)\n\n    @pytest.mark.parametrize(\n        ("on_finish_action", "pod_phase", "should_delete"),\n        [\n            (OnFinishAction.DELETE_POD, PodPhase.PENDING, True),\n            (OnFinishAction.DELETE_POD, PodPhase.RUNNING, True),\n            (OnFinishAction.DELETE_POD, PodPhase.SUCCEEDED, True),\n            (OnFinishAction.DELETE_POD, PodPhase.FAILED, True),\n            (OnFinishAction.DELETE_SUCCEEDED_POD, PodPhase.PENDING, False),\n            (OnFinishAction.DELETE_SUCCEEDED_POD, PodPhase.RUNNING, False),\n            (OnFinishAction.DELETE_SUCCEEDED_POD, PodPhase.SUCCEEDED, True),\n            (OnFinishAction.DELETE_SUCCEEDED_POD, PodPhase.FAILED, False),\n            (OnFinishAction.DELETE_ACTIVE_POD, PodPhase.PENDING, True),\n            (OnFinishAction.DELETE_ACTIVE_POD, PodPhase.RUNNING, True),\n            (OnFinishAction.DELETE_ACTIVE_POD, PodPhase.SUCCEEDED, False),\n            (OnFinishAction.DELETE_ACTIVE_POD, PodPhase.FAILED, False),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    def test_process_pod_deletion(self, delete_pod_mock, on_finish_action, pod_phase, should_delete):\n        """Test KubernetesPodOperator pod cleanup behavior across all modes and pod phases."""\n\n        _r7338d35652 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n        )\n\n        _r7338d35652.on_finish_action = on_finish_action\n\n        _r14445e45e9 = MagicMock()\n        _r14445e45e9.metadata.name = "pod-name"\n        _r14445e45e9.status.phase = pod_phase\n\n        _rec49c85a0f = _r7338d35652.process_pod_deletion(_r14445e45e9)\n\n        # Assert deletion side-effect behavior\n        if should_delete:\n            delete_pod_mock.assert_called_once_with(_r14445e45e9)\n        else:\n            delete_pod_mock.assert_not_called()\n\n        assert _rec49c85a0f == should_delete\n\n    @pytest.mark.parametrize(\n        "pod_phase",\n        [\n            PodPhase.SUCCEEDED,\n            PodPhase.FAILED,\n            PodPhase.RUNNING,\n        ],\n    )\n    @patch(f"{KPO_MODULE}.PodManager.create_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.process_pod_deletion")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_get_or_create_pod_reattach_terminated(\n        self, mock_find, mock_process_pod_deletion, mock_create_pod, pod_phase\n    ):\n        """Check that get_or_create_pod reattaches to existing pod."""\n        _r16d33167e1 = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n            log_pod_spec_on_failure=False,\n        )\n        _r16d33167e1.reattach_on_restart = True\n        _re0b62e187d = create_context(_r16d33167e1)\n        _rffc232d110 = MagicMock()\n        _rffc232d110.to_dict.return_value = {"metadata": {"name": "test-pod"}}\n\n        _r84b7c8fc36 = MagicMock()\n        _r84b7c8fc36.status.phase = pod_phase\n        mock_find.return_value = _r84b7c8fc36\n        _refd03b2bf6 = _r16d33167e1.get_or_create_pod(\n            pod_request_obj=_rffc232d110,\n            context=_re0b62e187d,\n        )\n        if pod_phase == PodPhase.RUNNING:\n            mock_create_pod.assert_not_called()\n            mock_process_pod_deletion.assert_not_called()\n            assert _refd03b2bf6 == _r84b7c8fc36\n        else:\n            mock_process_pod_deletion.assert_called_once_with(_r84b7c8fc36)\n            mock_create_pod.assert_called_once_with(pod=_rffc232d110)\n            assert _refd03b2bf6 == _rffc232d110\n\n    @pytest.mark.parametrize(\n        ("pod_phase", "pod_reason", "should_reuse"),\n        [\n            ("Running", "", True),\n            ("Running", "Evicted", False),\n            ("Succeeded", None, False),\n            ("Failed", None, False),\n        ],\n        ids=["running", "evicted", "succeeded", "failed"],\n    )\n    @patch(f"{KPO_MODULE}.PodManager.create_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.process_pod_deletion")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_get_or_create_pod_reattach_with_evicted(\n        self,\n        mock_find,\n        mock_process_pod_deletion,\n        mock_create_pod,\n        pod_phase,\n        pod_reason,\n        should_reuse,\n    ):\n        """Test that get_or_create_pod reattaches or recreates pod based on phase and reason."""\n        _r07f169897e = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n            log_pod_spec_on_failure=False,\n        )\n        _r07f169897e.reattach_on_restart = True\n        _r2512a35073 = create_context(_r07f169897e)\n        _r096dfbf73f = MagicMock()\n        _r096dfbf73f.to_dict.return_value = {"metadata": {"name": "test-pod"}}\n\n        _r5d801ea566 = MagicMock()\n        _r5d801ea566.status.phase = pod_phase\n        _r5d801ea566.status.reason = pod_reason\n        mock_find.return_value = _r5d801ea566\n\n        _r84fcfff110 = _r07f169897e.get_or_create_pod(\n            pod_request_obj=_r096dfbf73f,\n            context=_r2512a35073,\n        )\n\n        if should_reuse:\n            mock_create_pod.assert_not_called()\n            mock_process_pod_deletion.assert_not_called()\n            assert _r84fcfff110 == _r5d801ea566\n        else:\n            mock_process_pod_deletion.assert_called_once_with(_r5d801ea566)\n            mock_create_pod.assert_called_once_with(pod=_r096dfbf73f)\n            assert _r84fcfff110 == _r096dfbf73f\n\n    def test_xcom_sidecar_container_image_custom(self):\n        _re23251f236 = "private.repo/alpine:3.24.2"\n        with temp_override_attr(PodDefaults.SIDECAR_CONTAINER, "image", _re23251f236):\n            _r9e44cfa2cd = KubernetesPodOperator(\n                name="test",\n                task_id="task",\n                do_xcom_push=True,\n            )\n            _rb4d1264246 = _r9e44cfa2cd.build_pod_request_obj(create_context(_r9e44cfa2cd))\n        assert _rb4d1264246.spec.containers[1].image == _re23251f236\n\n    def test_xcom_sidecar_container_image_default(self):\n        _re545d70f91 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n        )\n        _r90eadfa539 = _re545d70f91.build_pod_request_obj(create_context(_re545d70f91))\n        assert _r90eadfa539.spec.containers[1].image == "alpine:3.24.2"\n\n    def test_xcom_sidecar_container_resources_default(self):\n        _r167aeb8d6c = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n        )\n        _rb6910cabae = _r167aeb8d6c.build_pod_request_obj(create_context(_r167aeb8d6c))\n        assert _rb6910cabae.spec.containers[1].resources == k8s.V1ResourceRequirements(\n            requests={\n                "cpu": "1m",\n                "memory": "10Mi",\n            },\n        )\n\n    def test_xcom_sidecar_container_resources_custom(self):\n        _r89a4536cf3 = {\n            "requests": {"cpu": "1m", "memory": "10Mi"},\n            "limits": {"cpu": "10m", "memory": "50Mi"},\n        }\n        with temp_override_attr(PodDefaults.SIDECAR_CONTAINER, "resources", _r89a4536cf3):\n            _r97