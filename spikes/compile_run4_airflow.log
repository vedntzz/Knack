,\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n            callbacks=MockKubernetesPodOperatorCallback,\n        )\n        _r0106e42b48 = create_context(_r48d88009f1)\n\n        _r48d88009f1.trigger_reentry(\n            context=_r0106e42b48,\n            event={\n                "status": "success",\n                "message": TEST_SUCCESS_MESSAGE,\n                "name": TEST_NAME,\n                "namespace": TEST_NAMESPACE,\n            },\n        )\n\n        # check on_operator_resuming callback\n        _ra9fe82d380.on_pod_cleanup.assert_called_once()\n        assert _ra9fe82d380.on_pod_cleanup.call_args.kwargs == {\n            "client": _r48d88009f1.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r91ab61faa0,\n            "operator": _r48d88009f1,\n            "context": _r0106e42b48,\n        }\n\n        # check on_pod_cleanup callback\n        _ra9fe82d380.on_pod_cleanup.assert_called_once()\n        assert _ra9fe82d380.on_pod_cleanup.call_args.kwargs == {\n            "client": _r48d88009f1.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r91ab61faa0,\n            "operator": _r48d88009f1,\n            "context": _r0106e42b48,\n        }\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize("get_logs", [True, False])\n    @patch(f"{POD_MANAGER_CLASS}.fetch_requested_container_logs")\n    @patch(f"{POD_MANAGER_CLASS}.await_container_completion")\n    @patch(f"{POD_MANAGER_CLASS}.read_pod")\n    def test_await_container_completion_refreshes_properties_on_exception(\n        self, mock_read_pod, mock_await_container_completion, fetch_requested_container_logs, get_logs\n    ):\n        _ree9aeeb754 = KubernetesPodOperator(task_id="task", get_logs=get_logs)\n        _r4c7637dec0, _r9264c0af85 = self.run_pod(_ree9aeeb754)\n        _rf1e2204113, _r66decaea6f, _r69d2d8819f = _ree9aeeb754.client, _ree9aeeb754.hook, _ree9aeeb754.pod_manager\n\n        # no exception doesn\'t update properties\n        _ree9aeeb754.await_pod_completion(_r4c7637dec0)\n        assert _rf1e2204113 == _ree9aeeb754.client\n        assert _r66decaea6f == _ree9aeeb754.hook\n        assert _r69d2d8819f == _ree9aeeb754.pod_manager\n\n        # exception refreshes properties\n        mock_await_container_completion.side_effect = [ApiException(status=401), mock.DEFAULT]\n        fetch_requested_container_logs.side_effect = [ApiException(status=401), mock.DEFAULT]\n        _ree9aeeb754.await_pod_completion(_r4c7637dec0)\n\n        if get_logs:\n            fetch_requested_container_logs.assert_has_calls(\n                [\n                    mock.call(\n                        pod=_r4c7637dec0,\n                        containers=_ree9aeeb754.container_logs,\n                        follow_logs=True,\n                        container_name_log_prefix_enabled=True,\n                        log_formatter=None,\n                    )\n                ]\n                * 3\n            )\n        else:\n            mock_await_container_completion.assert_has_calls(\n                [mock.call(pod=_r4c7637dec0, container_name=_ree9aeeb754.base_container_name, polling_time=1)] * 3\n            )\n        mock_read_pod.assert_called()\n        assert _rf1e2204113 != _ree9aeeb754.client\n        assert _r66decaea6f != _ree9aeeb754.hook\n        assert _r69d2d8819f != _ree9aeeb754.pod_manager\n\n    @pytest.mark.asyncio\n    @patch(f"{POD_MANAGER_CLASS}.await_container_completion")\n    @patch(f"{POD_MANAGER_CLASS}.read_pod")\n    def test_await_container_completion_raises_unauthorized_if_credentials_still_invalid_after_refresh(\n        self, mock_read_pod, mock_await_container_completion\n    ):\n        _rbe83acc4e4 = KubernetesPodOperator(task_id="task", get_logs=False)\n        _rdd41b22544, _rca8cb70807 = self.run_pod(_rbe83acc4e4)\n        _r11bf4fc89d, _reb3db193ba, _r90fd7455a4 = _rbe83acc4e4.client, _rbe83acc4e4.hook, _rbe83acc4e4.pod_manager\n\n        mock_await_container_completion.side_effect = [ApiException(status=401)]\n        mock_read_pod.side_effect = [ApiException(status=401)]\n\n        with pytest.raises(ApiException):\n            _rbe83acc4e4.await_pod_completion(_rdd41b22544)\n\n        mock_read_pod.assert_called()\n        # assert cache was refreshed\n        assert _r11bf4fc89d != _rbe83acc4e4.client\n        assert _reb3db193ba != _rbe83acc4e4.hook\n        assert _r90fd7455a4 != _rbe83acc4e4.pod_manager\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize(\n        ("side_effect", "exception_type", "expect_exc"),\n        [\n            ([ApiException(401), mock.DEFAULT], ApiException, True),  # works after one 401\n            ([ApiException(401)] * 3 + [mock.DEFAULT], ApiException, True),  # works after 3 retries\n            ([ApiException(402)], ApiException, False),  # exc on non-401\n            ([ApiException(500)], ApiException, False),  # exc on non-401\n            ([Exception], Exception, False),  # exc on different exception\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.await_container_completion")\n    def test_await_container_completion_retries_on_specific_exception(\n        self, mock_await_container_completion, side_effect, exception_type, expect_exc\n    ):\n        _r73d21561d6 = KubernetesPodOperator(\n            task_id="task",\n            get_logs=False,\n        )\n        _r57f174a770, _r148341959f = self.run_pod(_r73d21561d6)\n        mock_await_container_completion.side_effect = side_effect\n        if expect_exc:\n            _r73d21561d6.await_pod_completion(_r57f174a770)\n        else:\n            with pytest.raises(exception_type):\n                _r73d21561d6.await_pod_completion(_r57f174a770)\n        _rac5431edc0 = len(side_effect)\n        mock_await_container_completion.assert_has_calls(\n            [mock.call(pod=_r57f174a770, container_name=_r73d21561d6.base_container_name, polling_time=1)] * _rac5431edc0\n        )\n\n    @pytest.mark.parametrize(\n        "on_finish_action",\n        [OnFinishAction.KEEP_POD, OnFinishAction.DELETE_ACTIVE_POD, OnFinishAction.DELETE_SUCCEEDED_POD],\n    )\n    @patch(KUB_OP_PATH.format("patch_already_checked"))\n    @patch(KUB_OP_PATH.format("process_pod_deletion"))\n    def test_process_duplicate_label_pods__label_patched_if_action_is_not_delete_pod(\n        self,\n        process_pod_deletion_mock,\n        patch_already_checked_mock,\n        on_finish_action,\n    ):\n        _r7a1b916d4b = datetime.datetime.now()\n        _re3a460bd8e = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:22.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 12"],\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n            durable=False,\n            on_finish_action=on_finish_action,\n        )\n        _ra465a98383 = create_context(_re3a460bd8e)\n        _r27d2995702 = _re3a460bd8e.get_or_create_pod(pod_request_obj=_re3a460bd8e.build_pod_request_obj(_ra465a98383), context=_ra465a98383)\n        _rbcb6cda0af = _re3a460bd8e.get_or_create_pod(pod_request_obj=_re3a460bd8e.build_pod_request_obj(_ra465a98383), context=_ra465a98383)\n\n        _r27d2995702.status = {"start_time": _r7a1b916d4b}\n        _rbcb6cda0af.status = {"start_time": _r7a1b916d4b + datetime.timedelta(seconds=60)}\n        _rbcb6cda0af.metadata.labels.update({"try_number": "2"})\n\n        _rff3d28976d = _re3a460bd8e.process_duplicate_label_pods([_r27d2995702, _rbcb6cda0af])\n\n        patch_already_checked_mock.assert_called_once_with(_r27d2995702, reraise=False)\n        process_pod_deletion_mock.assert_not_called()\n        assert _rff3d28976d.metadata.name == _rbcb6cda0af.metadata.name\n\n    @pytest.mark.parametrize(\n        "on_finish_action", [OnFinishAction.KEEP_POD, OnFinishAction.DELETE_SUCCEEDED_POD]\n    )\n    @patch(KUB_OP_PATH.format("patch_already_checked"))\n    @patch(KUB_OP_PATH.format("process_pod_deletion"))\n    def test_process_duplicate_label_pods_with_start_time_none(\n        self,\n        process_pod_deletion_mock,\n        patch_already_checked_mock,\n        on_finish_action,\n    ):\n        _ra2cd3040be = datetime.datetime.now()\n        _r7664c4a82c = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:22.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 12"],\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n            durable=False,\n            on_finish_action=on_finish_action,\n        )\n        _re1d35f6a3b = create_context(_r7664c4a82c)\n        _rf95467cda2 = _r7664c4a82c.get_or_create_pod(pod_request_obj=_r7664c4a82c.build_pod_request_obj(_re1d35f6a3b), context=_re1d35f6a3b)\n        _r81cf4dfd3d = _r7664c4a82c.get_or_create_pod(pod_request_obj=_r7664c4a82c.build_pod_request_obj(_re1d35f6a3b), context=_re1d35f6a3b)\n\n        _rf95467cda2.status = {"start_time": None}\n        _r81cf4dfd3d.status = {"start_time": None}\n        _rf95467cda2.metadata.creation_timestamp = _ra2cd3040be\n        _r81cf4dfd3d.metadata.creation_timestamp = _ra2cd3040be + datetime.timedelta(seconds=60)\n        _r81cf4dfd3d.metadata.labels.update({"try_number": "2"})\n\n        _racf3e1a830 = _r7664c4a82c.process_duplicate_label_pods([_rf95467cda2, _r81cf4dfd3d])\n\n        patch_already_checked_mock.assert_called_once_with(_rf95467cda2, reraise=False)\n        process_pod_deletion_mock.assert_not_called()\n        assert _racf3e1a830.metadata.name == _r81cf4dfd3d.metadata.name\n\n    @patch(KUB_OP_PATH.format("patch_already_checked"))\n    @patch(KUB_OP_PATH.format("process_pod_deletion"))\n    def test_process_duplicate_label_pods__pod_removed_if_delete_pod(\n        self, process_pod_deletion_mock, patch_already_checked_mock\n    ):\n        _r9433f778ba = datetime.datetime.now()\n        _r572a92bbed = KubernetesPodOperator(\n            