   )\n        _r2f10880e67 = _re4230f162a.build_pod_request_obj(create_context(_re4230f162a))\n        assert _r2f10880e67.spec.containers[1].security_context == _rc61e73af63\n\n    @patch(f"{HOOK_CLASS}.get_xcom_sidecar_container_security_context")\n    def test_xcom_sidecar_container_security_context_empty_operator_overrides_connection(\n        self, mock_get_security_context\n    ):\n        mock_get_security_context.return_value = {"readOnlyRootFilesystem": True}\n        _r1e2cbc30d6 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n            xcom_sidecar_container_security_context={},\n        )\n        _r3d2d3d9809 = _r1e2cbc30d6.build_pod_request_obj(create_context(_r1e2cbc30d6))\n        assert _r3d2d3d9809.spec.containers[1].security_context == {}\n\n    def test_image_pull_policy_correctly_set(self):\n        _rc2dde27439 = KubernetesPodOperator(\n            task_id="task",\n            image_pull_policy="Always",\n        )\n        _r9ba7ea271f = _rc2dde27439.build_pod_request_obj(create_context(_rc2dde27439))\n        assert _r9ba7ea271f.spec.containers[0].image_pull_policy == "Always"\n\n    def test_termination_message_policy_correctly_set(self):\n        _re15454f953 = KubernetesPodOperator(\n            task_id="task",\n            termination_message_policy="FallbackToLogsOnError",\n        )\n\n        _rb4f3163374 = _re15454f953.build_pod_request_obj(create_context(_re15454f953))\n        assert _rb4f3163374.spec.containers[0].termination_message_policy == "FallbackToLogsOnError"\n\n    def test_termination_message_policy_default_value_correctly_set(self):\n        _rc97745e7c7 = KubernetesPodOperator(\n            task_id="task",\n        )\n\n        _rcb91a8a329 = _rc97745e7c7.build_pod_request_obj(create_context(_rc97745e7c7))\n        assert _rcb91a8a329.spec.containers[0].termination_message_policy == "File"\n\n    def test_runtime_class_name_correctly_set(self):\n        _r26455ce3f7 = KubernetesPodOperator(\n            task_id="task",\n            runtime_class_name="gvisor",\n        )\n        _rfb309022b6 = _r26455ce3f7.build_pod_request_obj(create_context(_r26455ce3f7))\n        assert _rfb309022b6.spec.runtime_class_name == "gvisor"\n\n    def test_runtime_class_name_default_value_correctly_set(self):\n        _rcb9a52306c = KubernetesPodOperator(\n            task_id="task",\n        )\n        _r7aac7e556b = _rcb9a52306c.build_pod_request_obj(create_context(_rcb9a52306c))\n        assert _r7aac7e556b.spec.runtime_class_name is None\n\n    def test_termination_grace_period_correctly_set(self):\n        _rf1b35a8718 = KubernetesPodOperator(\n            task_id="task",\n            termination_grace_period=300,\n        )\n\n        _r078010ffab = _rf1b35a8718.build_pod_request_obj(create_context(_rf1b35a8718))\n        assert _r078010ffab.spec.termination_grace_period_seconds == 300\n\n    def test_termination_grace_period_default_value_correctly_set(self):\n        _re7c74146d7 = KubernetesPodOperator(\n            task_id="task",\n        )\n\n        _r9e3afec6c3 = _re7c74146d7.build_pod_request_obj(create_context(_re7c74146d7))\n        assert _r9e3afec6c3.spec.termination_grace_period_seconds is None\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize(\n        ("task_kwargs", "base_container_fail", "expect_to_delete_pod"),\n        [\n            ({"on_finish_action": "delete_pod"}, True, True),\n            ({"on_finish_action": "delete_pod"}, False, True),\n            ({"on_finish_action": "keep_pod"}, False, False),\n            ({"on_finish_action": "keep_pod"}, True, False),\n            ({"on_finish_action": "delete_succeeded_pod"}, False, True),\n            ({"on_finish_action": "delete_succeeded_pod"}, True, False),\n            ({"on_finish_action": "delete_active_pod"}, True, True),\n            ({"on_finish_action": "delete_active_pod"}, False, True),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.is_istio_enabled")\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_pod_with_istio_delete_after_await_container_error(\n        self,\n        find_pod_mock,\n        await_pod_completion_mock,\n        is_istio_enabled_mock,\n        delete_pod_mock,\n        task_kwargs,\n        base_container_fail,\n        expect_to_delete_pod,\n    ):\n        """\n        When KPO fails unexpectedly during await_container, we should still try to delete the pod,\n        and the pod we try to delete should be the one returned from find_pod earlier.\n        """\n        _r4060a91ae1 = MagicMock()\n        _r4060a91ae1.name = "istio-proxy"\n        _r4060a91ae1.namespace = "default"\n        _r4060a91ae1.image = "istio/proxyv2:1.18.2"\n        _r4060a91ae1.args = []\n        _r4060a91ae1.state.running = True\n\n        _r705b433568 = MagicMock()\n        _r705b433568.name = "base"\n        _r705b433568.state.running = False\n        _r705b433568.state.terminated.exit_code = 0\n        if base_container_fail:\n            _r705b433568.state.terminated.exit_code = 1\n            _r705b433568.state.terminated.message = "my-failure"\n\n        _r5eb4681ba9 = MagicMock()\n        _r5eb4681ba9.name = "istio-proxy"\n        _r5eb4681ba9.state.running = True\n        _r5eb4681ba9.state.terminated = False\n\n        await_pod_completion_mock.return_value.spec.containers = [_r4060a91ae1, _r705b433568, _r5eb4681ba9]\n        await_pod_completion_mock.return_value.status.phase = "Running"\n        await_pod_completion_mock.return_value.status.container_statuses = [_r705b433568, _r5eb4681ba9]\n        await_pod_completion_mock.return_value.metadata.name = "pod-with-istio-sidecar"\n        await_pod_completion_mock.return_value.metadata.namespace = "default"\n\n        find_pod_mock.return_value.spec.containers = [_r4060a91ae1, _r705b433568, _r5eb4681ba9]\n        find_pod_mock.return_value.status.phase = "Running"\n        find_pod_mock.return_value.status.container_statuses = [_r705b433568, _r5eb4681ba9]\n        find_pod_mock.return_value.metadata.name = "pod-with-istio-sidecar"\n        find_pod_mock.return_value.metadata.namespace = "default"\n\n        _rb05ab65c0d = KubernetesPodOperator(task_id="task", **task_kwargs)\n\n        _r38a1d10d7b = create_context(_rb05ab65c0d)\n        _r38a1d10d7b["ti"].xcom_push = MagicMock()\n\n        if base_container_fail:\n            self.await_pod_mock.side_effect = AirflowException("fake failure")\n            with pytest.raises(AirflowException, match="my-failure"):\n                _rb05ab65c0d.execute(context=_r38a1d10d7b)\n        else:\n            _rb05ab65c0d.execute(context=_r38a1d10d7b)\n\n        if expect_to_delete_pod:\n            assert _rb05ab65c0d.is_istio_enabled(find_pod_mock.return_value)\n            delete_pod_mock.assert_called_with(await_pod_completion_mock.return_value)\n        else:\n            delete_pod_mock.assert_not_called()\n\n    @pytest.mark.parametrize(\n        ("base_container_exit_code", "expect_failure"),\n        [\n            pytest.param(0, False, id="base-succeeded"),\n            pytest.param(1, True, id="base-failed"),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.extract_xcom")\n    @patch(f"{POD_MANAGER_CLASS}.await_xcom_sidecar_container_start")\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_cleanup_with_xcom_sidecar_uses_base_container_status(\n        self,\n        find_pod_mock,\n        await_pod_completion_mock,\n        delete_pod_mock,\n        mock_await_xcom_sidecar,\n        mock_extract_xcom,\n        base_container_exit_code,\n        expect_failure,\n    ):\n        """\n        When do_xcom_push=True, cleanup should determine success/failure based on\n        the base container\'s exit status, not the pod phase. The xcom sidecar may\n        keep the pod in Running phase after the base container completes.\n        """\n        mock_extract_xcom.return_value = "{}"\n        mock_await_xcom_sidecar.return_value = None\n\n        _re5b063ec6d = MagicMock()\n        _re5b063ec6d.name = "base"\n        _re5b063ec6d.state.terminated.exit_code = base_container_exit_code\n        _re5b063ec6d.state.terminated.message = "task failed" if base_container_exit_code else None\n\n        _rd0f0bf7872 = MagicMock()\n        _rd0f0bf7872.name = "airflow-xcom-sidecar"\n        _rd0f0bf7872.state.running = True\n        _rd0f0bf7872.state.terminated = None\n\n        # Pod is still Running because xcom sidecar is alive\n        _ra482d3e50f = MagicMock()\n        _ra482d3e50f.status.phase = "Running"\n        _ra482d3e50f.status.container_statuses = [_re5b063ec6d, _rd0f0bf7872]\n        _ra482d3e50f.metadata.name = "pod-with-xcom-sidecar"\n        _ra482d3e50f.metadata.namespace = "default"\n        _ra482d3e50f.spec.containers = [MagicMock(), MagicMock()]\n\n        await_pod_completion_mock.return_value = _ra482d3e50f\n        find_pod_mock.return_value = _ra482d3e50f\n\n        _r3c1c5196a9 = KubernetesPodOperator(\n            task_id="task",\n            do_xcom_push=True,\n        )\n\n        _r05a890f07f = create_context(_r3c1c5196a9)\n        _r05a890f07f["ti"].xcom_push = MagicMock()\n\n        if expect_failure:\n            with pytest.raises(AirflowException, match="task failed"):\n                _r3c1c5196a9.execute(context=_r05a890f07f)\n        else:\n            _r3c1c5196a9.execute(context=_r05a890f07f)\n\n    @pytest.mark.parametrize(\n        ("task_kwargs", "should_be_deleted"),\n        [\n            pytest.param({}, True, id="default"),  # default values\n            pytest.param({"on_finish_action": "delete_pod"}, True, id="delete-pod"),\n            pytest.param({"on_finish_action": "delete_succeeded_pod"}, False, id="delete-succeeded-pod"),\n            pytest.param({"on_finish_action": "keep_pod"}, False, id="keep-pod"),\n            pytest.param({"on_finish_action": "delete_active_pod"}, False, id="delete-active-pod"),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_pod_delete_after_await_container_error(\n        self, find_pod_mock, delete_pod_mock, task_kwargs, should_be_deleted\n    ):\n        """\n        When KPO fails unexpectedly during await_container, we should still try to delete the pod,\n        and the pod we try to delete should be the one returned from find_pod earlier.\n        """\n        _re065e74633 = MagicMock()\n        _re065e74633.name = "base"\n        _re065e74633.state.terminated.message = "my-failure"\n        find_pod_mock.return_value.status.container_statuses = [_re065e74633]\n        _rbff046b2b5 = KubernetesPodOperator(task_id="task", **task_kwargs)\n        self.await_pod_mock.side_effect = AirflowException("fake failure")\n        _ree09134b3b = create_context(_rbff046b2b5)\n        _ree09134b3b["ti"].xcom_push = MagicMock()\n        with pytest.raises(AirflowException, match="my-failure"):\n            _rbff046b2b5.execute(context=_ree09134b3b)\n        if should_be_deleted:\n            delete_pod_mock.assert_called_with(find_pod_mock.return_value)\n        else:\n            delete_pod_mock.assert_not_called()\n\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.await_init_containers_completion")\n    def test_execute_sync_checks_pod_start_before_following_init_container_logs(\n        self, await_init_mock, find_pod_mock, delete_pod_mock\n    ):\n        """Pod start is awaited before following init-container logs, so a Pending pod hits the\n        startup timeout instead of blocking forever in the init-log wait loop."""\n        find_pod_mock.return_value.status.phase = PodPhase.SUCCEEDED\n        self.await_start_mock.side_effect = PodLaunchTimeoutException("Pod took too long to start")\n        _rf348a1a494 = KubernetesPodOperator(task_id="task", init_container_logs=["init-container"])\n        _r9c84b4f9c4 = create_context(_rf348a1a494)\n        _r9c84b4f9c4["ti"].xcom_push = MagicMock()\n\n        with pytest.raises(PodLaunchTimeoutException, match="too long to start"):\n            _rf348a1a494.execute(context=_r9c84b4f9c4)\n\n        await_init_mock.assert_not_called()\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize("should_fail", [True, False])\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    def test_pod_delete_not_called_when_creation_fails(self, await_pod_mock, delete_pod_mock, should_fail):\n        """\n        When pod creation fails, we never get a read of the remote pod.  In this case we don\'t attempt\n        to delete the pod.\n        """\n        _r424e580cdc = KubernetesPodOperator(\n            task_id="task",\n            on_finish_action="delete_pod",\n        )\n\n        if should_fail:\n            self.create_mock.side_effect = AirflowException("fake failure")\n        else:\n            await_pod_mock.return_value.status.phase = "Succeeded"\n\n        _r9c0ed3d660 = pytest.raises(AirflowException) if should_fail else nullcontext()\n        with _r9c0ed3d660:\n            self.run_pod(_r424e580cdc)\n\n        if should_fail:\n            delete_pod_mock.assert_not_called()\n        else:\n            delete_pod_mock.assert_called()\n\n    @pytest.mark.parametrize("randomize", [True, False])\n    def test_provided_pod_name(self, randomize):\n        _r06b9a7fb22 = "test"\n        _r42699cbc9b = KubernetesPodOperator(\n            name=_r06b9a7fb22,\n            random_name_suffix=randomize,\n            task_id="task",\n        )\n        _r4e9da62821 = create_context(_r42699cbc9b)\n        _ra196c9c22c = _r42699cbc9b.build_pod_request_obj(_r4e9da62821)\n\n        if randomize:\n            assert _ra196c9c22c.metadata.name.startswith(_r06b9a7fb22)\n            assert _ra196c9c22c.metadata.name != _r06b9a7fb22\n        else:\n            assert _ra196c9c22c.metadata.name == _r06b9a7fb22\n\n    @pytest.fixture\n    def pod_spec(self):\n        return k8s.V1Pod(\n            metadata=k8s.V1ObjectMeta(name="hello", labels={"foo": "bar"}, namespace="podspecnamespace"),\n            spec=k8s.V1PodSpec(\n                containers=[\n                    k8s.V1Container(\n                        name="base",\n                        image="ubuntu:16.04",\n                        command=["something"],\n                    )\n                ]\n            ),\n        )\n\n    @pytest.mark.parametrize("randomize_name", (True, False))\n    def test_full_pod_spec(self, randomize_name, pod_spec):\n        _re174656573 = pod_spec.metadata.name\n\n        _r29a72259ee = KubernetesPodOperator(\n            task_id="task",\n            random_name_suffix=randomize_name,\n            full_pod_spec=pod_spec,\n        )\n        _r49f95c0836 = create_context(_r29a72259ee)\n        _r483b8fd006 = _r29a72259ee.build_pod_request_obj(_r49f95c0836)\n\n        if randomize_name:\n            assert _r483b8fd006.metadata.name.startswith(_re174656573)\n            assert _r483b8fd006.metadata.name != _re174656573\n        else:\n            assert _r483b8fd006.metadata.name == _re174656573\n        assert _r483b8fd006.metadata.namespace == pod_spec.metadata.namespace\n        assert _r483b8fd006.spec.containers[0].image == pod_spec.spec.containers[0].image\n        assert _r483b8fd006.spec.containers[0].command == pod_spec.spec.containers[0].command\n        # Check labels are added from pod_template_file and\n        # the pod identifying labels including Airflow version\n        assert _r483b8fd006.metadata.labels == {\n            "foo": "bar",\n            "dag_id": "dag",\n            "kubernetes_pod_operator": "True",\n            "task_id": "task",\n            "try_number": mock.ANY,\n            "airflow_version": mock.ANY,\n            "airflow_kpo_in_cluster": str(_r29a72259ee.hook.is_in_cluster),\n            "run_id": "test",\n        }\n\n    @pytest.mark.parametrize("randomize_name", (True, False))\n    def test_full_pod_spec_kwargs(self, randomize_name, pod_spec):\n        # kwargs take precedence, however\n        _r43061ac7a3 = "some.custom.image:andtag"\n        _rdd2714a265 = "world"\n        _r90bdc11335 = KubernetesPodOperator(\n            task_id="task",\n            random_name_suffix=randomize_name,\n            full_pod_spec=pod_spec,\n            name=_rdd2714a265,\n            image=_r43061ac7a3,\n            labels={"hello": "world"},\n        )\n        _ra5b418ff9b = _r90bdc11335.build_pod_request_obj(create_context(_r90bdc11335))\n\n        # make sure the kwargs takes precedence (and that name is randomized when expected)\n        if randomize_name:\n            assert _ra5b418ff9b.metadata.name.startswith(_rdd2714a265)\n            assert _ra5b418ff9b.metadata.name != _rdd2714a265\n        else:\n            assert _ra5b418ff9b.metadata.name == _rdd2714a265\n        assert _ra5b418ff9b.spec.containers[0].image == _r43061ac7a3\n        # Check labels are added from pod_template_file, the operator itself and\n        # the pod identifying labels including Airflow version\n        assert _ra5b418ff9b.metadata.labels == {\n            "foo": "bar",\n            "hello": "world",\n            "dag_id": "dag",\n            "kubernetes_pod_operator": "True",\n            "task_id": "task",\n            "try_number": mock.ANY,\n            "airflow_version": mock.ANY,\n            "airflow_kpo_in_cluster": str(_r90bdc11335.hook.is_in_cluster),\n            "run_id": "test",\n        }\n\n    @pytest.fixture\n    def pod_template_file(self, tmp_path):\n        _r49166132b9 = """\n            apiVersion: v1\n            kind: Pod\n            metadata:\n              name: hello\n              namespace: templatenamespace\n              labels:\n                foo: bar\n            spec:\n              serviceAccountName: foo\n              automountServiceAccountToken: false\n              affinity:\n                nodeAffinity:\n                  requiredDuringSchedulingIgnoredDuringExecution:\n                    nodeSelectorTerms:\n                    - matchExpressions:\n                      - key: kubernetes.io/role\n                        operator: In\n                        values:\n                        - foo\n                        - bar\n                  preferredDuringSchedulingIgnoredDuringExecution:\n                  - weight: 1\n                    preference:\n                      matchExpressions:\n                      - key: kubernetes.io/role\n                        operator: In\n                        values:\n                        - foo\n                        - bar\n              containers:\n                - name: base\n                  image: ubuntu:16.04\n                  imagePullPolicy: Always\n                  command:\n                    - something\n        """\n\n        _rf747a1d811 = tmp_path / "template.yaml"\n        _rf747a1d811.write_text(_r49166132b9)\n\n        return _rf747a1d811\n\n    @pytest.mark.parametrize("randomize_name", (True, False))\n    def test_pod_template_file(self, randomize_name, pod_template_file):\n        _re6e026d0c5 = KubernetesPodOperator(\n            task_id="task",\n            random_name_suffix=randomize_name,\n            pod_template_file=pod_template_file,\n        )\n        _rb9ee853902 = _re6e026d0c5.build_pod_request_obj(create_context(_re6e026d0c5))\n\n        if randomize_name:\n            assert _rb9ee853902.metadata.name.startswith("hello")\n            assert _rb9ee853902.metadata.name != "hello"\n        else:\n            assert _rb9ee853902.metadata.name == "hello"\n        # Check labels are added from pod_template_file and\n        # the pod identifying labels including Airflow version\n        assert _rb9ee853902.metadata.labels == {\n            "foo": "bar",\n            "dag_id": "dag",\n            "kubernetes_pod_operator": "True",\n            "task_id": "task",\n            "try_number": mock.ANY,\n            "airflow_version": mock.ANY,\n            "airflow_kpo_in_cluster": str(_re6e026d0c5.hook.is_in_cluster),\n            "run_id": "test",\n        }\n        assert _rb9ee853902.metadata.namespace == "templatenamespace"\n        assert _rb9ee853902.spec.containers[0].image == "ubuntu:16.04"\n        assert _rb9ee853902.spec.containers[0].image_pull_policy == "Always"\n        assert _rb9ee853902.spec.containers[0].command == ["something"]\n        assert _rb9ee853902.spec.service_account_name == "foo"\n        assert not _rb9ee853902.spec.automount_service_account_token\n\n        _rfa96bef830 = {\n            "node_affinity": {\n                "preferred_during_scheduling_ignored_during_execution": [\n                    {\n                        "preference": {\n                            "match_expressions": [\n                                {"key": "kubernetes.io/role", "operator": "In", "values": ["foo", "bar"]}\n                            ],\n                            "match_fields": None,\n                        },\n                        "weight": 1,\n                    }\n                ],\n                "required_during_scheduling_ignored_during_execution": {\n                    "node_selector_terms": [\n                        {\n                            "match_expressions": [\n                                {"key": "kubernetes.io/role", "operator": "In", "values": ["foo", "bar"]}\n                            ],\n                            "match_fields": None,\n                        }\n                    ]\n                },\n            },\n            "pod_affinity": None,\n            "pod_anti_affinity": None,\n        }\n\n        assert _rb9ee853902.spec.affinity.to_dict() == _rfa96bef830\n\n    @pytest.mark.parametrize("randomize_name", (True, False))\n    def test_pod_template_file_kwargs_override(self, randomize_name, pod_template_file):\n        # kwargs take precedence, however\n        _rc2e3311e38 = "some.custom.image:andtag"\n        _r8266ffa7db = "world"\n        _rdad621ced7 = KubernetesPodOperator(\n            task_id="task",\n            pod_template_file=pod_template_file,\n            name=_r8266ffa7db,\n            random_name_suffix=randomize_name,\n            image=_rc2e3311e38,\n            labels={"hello": "world"},\n        )\n        _r3fe3db2c6f = _rdad621ced7.build_pod_request_obj(create_context(_rdad621ced7))\n\n        # make sure the kwargs takes precedence (and that name is randomized when expected)\n        if randomize_name:\n            assert _r3fe3db2c6f.metadata.name.startswith(_r8266ffa7db)\n            assert _r3fe3db2c6f.metadata.name != _r8266ffa7db\n        else:\n            assert _r3fe3db2c6f.metadata.name == _r8266ffa7db\n        assert _r3fe3db2c6f.spec.containers[0].image == _rc2e3311e38\n        # Check labels are added from pod_template_file, the operator itself and\n        # the pod identifying labels including Airflow version\n        assert _r3fe3db2c6f.metadata.labels == {\n            "foo": "bar",\n            "hello": "world",\n            "dag_id": "dag",\n            "kubernetes_pod_operator": "True",\n            "task_id": "task",\n            "try_number": mock.ANY,\n            "airflow_version": mock.ANY,\n            "airflow_kpo_in_cluster": str(_rdad621ced7.hook.is_in_cluster),\n            "run_id": "test",\n        }\n\n    @pytest.mark.parametrize("randomize_name", (True, False))\n    def test_pod_template_dict(self, randomize_name):\n        _ra41ef37283 = k8s.V1Pod(\n            metadata=k8s.V1ObjectMeta(\n                namespace="templatenamespace",\n                name="hel