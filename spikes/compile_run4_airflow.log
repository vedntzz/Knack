rator(task_id="task", get_logs=True, container_logs=container_logs)\n        _r8f0a6a2332, _rde617aa73d = self.run_pod(_rbd153c0fc5)\n\n        if should_await_base:\n            mock_await_container_completion.assert_called_once_with(\n                pod=_r8f0a6a2332, container_name="base", polling_time=1\n            )\n        else:\n            mock_await_container_completion.assert_not_called()\n\n    @patch(HOOK_CLASS, new=MagicMock)\n    @patch(KUB_OP_PATH.format("find_pod"))\n    def test_execute_sync_callbacks(self, find_pod_mock):\n        from airflow.providers.cncf.kubernetes.callbacks import ExecutionMode\n\n        from unit.cncf.kubernetes.test_callbacks import (\n            MockKubernetesPodOperatorCallback,\n            MockWrapper,\n        )\n\n        MockWrapper.reset()\n        _rf0c73ccee6 = MockWrapper.mock_callbacks\n        _r14fffe4922 = [MagicMock(), MagicMock(), MagicMock()]\n        find_pod_mock.side_effect = [None] + _r14fffe4922\n\n        _r17f250198a = MagicMock()\n        _r17f250198a.status.phase = "Succeeded"\n        self.await_pod_mock.return_value = _r17f250198a\n        _r3f806d9004 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n            callbacks=MockKubernetesPodOperatorCallback,\n        )\n        _r12adb99f20, _r3b6d6d9d48 = self.run_pod(_r3f806d9004)\n\n        # check on_sync_client_creation callback\n        _rf0c73ccee6.on_sync_client_creation.assert_called_once()\n        assert _rf0c73ccee6.on_sync_client_creation.call_args.kwargs == {"client": _r3f806d9004.client, "operator": _r3f806d9004}\n\n        # check on_pod_manifest_created callback\n        _rf0c73ccee6.on_pod_manifest_created.assert_called_once()\n\n        # check on_pod_creation callback\n        _rf0c73ccee6.on_pod_creation.assert_called_once()\n        assert _rf0c73ccee6.on_pod_creation.call_args.kwargs == {\n            "client": _r3f806d9004.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r14fffe4922[0],\n            "operator": _r3f806d9004,\n            "context": _r3b6d6d9d48,\n        }\n\n        # check on_pod_starting callback\n        _rf0c73ccee6.on_pod_starting.assert_called_once()\n        assert _rf0c73ccee6.on_pod_starting.call_args.kwargs == {\n            "client": _r3f806d9004.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r14fffe4922[1],\n            "operator": _r3f806d9004,\n            "context": _r3b6d6d9d48,\n        }\n\n        # check on_pod_completion callback\n        _rf0c73ccee6.on_pod_completion.assert_called_once()\n        assert _rf0c73ccee6.on_pod_completion.call_args.kwargs == {\n            "client": _r3f806d9004.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r14fffe4922[2],\n            "operator": _r3f806d9004,\n            "context": _r3b6d6d9d48,\n        }\n\n        _rf0c73ccee6.on_pod_teardown.assert_called_once()\n        assert _rf0c73ccee6.on_pod_teardown.call_args.kwargs == {\n            "client": _r3f806d9004.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r14fffe4922[2],\n            "operator": _r3f806d9004,\n            "context": _r3b6d6d9d48,\n        }\n\n        # check on_pod_cleanup callback\n        _rf0c73ccee6.on_pod_cleanup.assert_called_once()\n        assert _rf0c73ccee6.on_pod_cleanup.call_args.kwargs == {\n            "client": _r3f806d9004.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r3f806d9004.pod,\n            "operator": _r3f806d9004,\n            "context": _r3b6d6d9d48,\n        }\n\n    @pytest.mark.asyncio\n    @patch(HOOK_CLASS, new=MagicMock)\n    @patch(KUB_OP_PATH.format("find_pod"))\n    def test_execute_sync_multiple_callbacks(self, find_pod_mock):\n        from airflow.p