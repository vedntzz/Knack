id: compiled-rule
language: python
severity: error
message: Reuse existing resumable_job.* counters tagged operator="KubernetesPodOperator"; do not invent KPO-specific metric names.
rule:
  any:
    - all:
        - kind: module
        - has:
            stopBy: end
            regex: 'get_or_create_pod'
        - has:
            stopBy: end
            regex: 'KubernetesPodOperator'
        - not:
            has:
              stopBy: end
              regex: 'resumable_job'
    - all:
        - pattern: 'Stats.incr($$$)'
        - regex: 'reconnect|resubmit|fresh_submit|already_succeeded|terminal'
        - not:
            regex: 'resumable_job'
    - all:
        - kind: string
        - regex: '\bkpo_|\bk8s_pod_|kubernetes_pod_operator\.'

