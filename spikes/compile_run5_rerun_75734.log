            stopBy: end
            pattern: class KubernetesPodOperator($$$): $$$
        - not:
            has:
              stopBy: end
              regex: resumable_job\.
    - all:
        - pattern: Stats.incr($$$)
        - inside:
            stopBy: end
            pattern: def get_or_create_pod($$$): $$$
        - not:
            regex: resumable_job\.

