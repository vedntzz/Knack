ffinity)\n        assert _r8d619b64b6["spec"]["affinity"] == _r7d1888b428\n\n    def test_tolerations(self):\n        _ra63027e0dc = [k8s.V1Toleration(key="key", operator="Equal", value="value")]\n\n        _rc50f72b24b = [{"key": "key", "operator": "Equal", "value": "value"}]\n\n        _r41092e90ea = KubernetesPodOperator(\n            task_id="task",\n            tolerations=_rc50f72b24b,\n        )\n\n        _rc682ef7d1c = _r41092e90ea.build_pod_request_obj(create_context(_r41092e90ea))\n        _r67757c99bf = self.sanitize_for_serialization(_rc682ef7d1c)\n        assert isinstance(_rc682ef7d1c.spec.tolerations[0], k8s.V1Toleration)\n        assert _r67757c99bf["spec"]["tolerations"] == _rc50f72b24b\n\n        _clear_all_db_objects()\n\n        _r41092e90ea = KubernetesPodOperator(\n            task_id="task",\n            tolerations=_ra63027e0dc,\n        )\n\n        _rc682ef7d1c = _r41092e90ea.build_pod_request_obj(create_context(_r41092e90ea))\n        _r67757c99bf = self.sanitize_for_serialization(_rc682ef7d1c)\n        assert isinstance(_rc682ef7d1c.spec.tolerations[0], k8s.V1Toleration)\n        assert _r67757c99bf["spec"]["tolerations"] == _rc50f72b24b\n\n    def test_node_selector(self):\n        _r635dbd2b23 = {"beta.kubernetes.io/os": "linux"}\n\n        _rdfaff67358 = KubernetesPodOperator(\n            task_id="task",\n            node_selector=_r635dbd2b23,\n        )\n\n        _r5e55f4dee8 = _rdfaff67358.build_pod_request_obj(create_context(_rdfaff67358))\n        _r5b3b2cac00 = self.sanitize_for_serialization(_r5e55f4dee8)\n        assert isinstance(_r5e55f4dee8.spec.node_selector, dict)\n        assert _r5b3b2cac00["spec"]["nodeSelector"] == _r635dbd2b23\n\n    def test_automount_service_account_token(self):\n        _r195c5b8e49 = False\n\n        _rf72192af4a = KubernetesPodOperator(\n            task_id="task",\n            automount_service_account_token=_r195c5b8e49,\n        )\n\n        _r7938487c8b = _rf72192af4a.build_pod_request_obj(create_context(_rf72192af4a))\n        _rdf55c3a4cb = self.sanitize_for_serialization(_r7938487c8b)\n        assert isinstance(_r7938487c8b.spec.automount_service_account_token, bool)\n        assert _rdf55c3a4cb["spec"]["automountServiceAccountToken"] == _r195c5b8e49\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize("do_xcom_push", [True, False])\n    @patch(f"{POD_MANAGER_CLASS}.extract_xcom")\n    @patch(f"{POD_MANAGER_CLASS}.await_xcom_sidecar_container_start")\n    def test_push_xcom_pod_info(\n        self, mock_await_xcom_sidecar_container_start, mock_extract_xcom, do_xcom_push\n    ):\n        """pod name and namespace are *always* pushed; do_xcom_push only controls xcom sidecar"""\n        mock_extract_xcom.return_value = "{}"\n        mock_await_xcom_sidecar_container_start.return_value = None\n        _rf65dcc20df = KubernetesPodOperator(\n            task_id="task",\n            do_xcom_push=do_xcom_push,\n        )\n\n        _r48ebd673c8, _ra06ad6b3d1 = self.run_pod(_rf65dcc20df)\n        if AIRFLOW_V_3_0_PLUS:\n            if AIRFLOW_V_3_1_PLUS:\n                with create_session() as _r5d1fbf2af6:\n                    _r9747ba4604 = XCom.get_many(\n                        run_id=self.dag_run.run_id, task_ids="task", key="pod_name"\n                    )\n                    _rea2acd93a0 = _r5d1fbf2af6.execute(\n                        _r9747ba4604.with_only_columns(\n                            _r9747ba4604.column_descriptions[0]["entity"].value\n                        )\n                    ).first()\n                    _r2d32092497 = XCom.get_many(\n                        run_id=self.dag_run.run_id, task_ids="task", key="pod_namespace"\n                    )\n                    _r1f9f052ef7 = _r5d1fbf2af6.execute(\n                        _r2d32092497.with_only_columns(\n                            _r2d32092497.column_descriptions[0]["entity"].value\n                        )\n                    ).first()\n            else:\n                _rea2acd93a0 = XCom.get_many(run_id=self.dag_run.run_id, task_ids="task", key="pod_name").first()\n                _r1f9f052ef7 = XCom.get_many(\n                    run_id=self.dag_run.run_id, task_ids="task", key="pod_namespace"\n                ).first()\n            _rea2acd93a0 = XCom.deserialize_value(_rea2acd93a0)\n            _r1f9f052ef7 = XCom.deserialize_value(_r1f9f052ef7)\n        else:\n            _rea2acd93a0 = XCom.get_one(run_id=self.dag_run.run_id, task_id="task", key="pod_name")\n            _r1f9f052ef7 = XCom.get_one(run_id=self.dag_run.run_id, task_id="task", key="pod_namespace")\n\n        assert _rea2acd93a0 == _r48ebd673c8.metadata.name\n        assert _r1f9f052ef7 == _r48ebd673c8.metadata.namespace\n\n    @pytest.mark.asyncio\n    @patch(HOOK_CLASS, new=MagicMock)\n    def test_previous_pods_ignored_for_reattached(self):\n        """\n        When looking for pods to possibly reattach to,\n        ignore pods from previous tries that were properly finished\n        """\n        _r9571a81846 = KubernetesPodOperator(\n            namespace="default",\n            task_id="task",\n        )\n        self.run_pod(_r9571a81846)\n        _r3a6c9af1db, _r885d7f8e73 = _r9571a81846.client.list_namespaced_pod.call_args\n        assert "already_checked!=True" in _r885d7f8e73["label_selector"]\n\n    @patch(KUB_OP_PATH.format("find_pod"))\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.patch_already_checked")\n    def test_mark_checked_unexpected_exception(\n        self, mock_patch_already_checked, mock_delete_pod, find_pod_mock\n    ):\n        """If we aren\'t deleting pods and have an exception, mark it so we don\'t reattach to it"""\n        _rab6e33b737 = KubernetesPodOperator(\n            task_id="task",\n            on_finish_action="keep_pod",\n        )\n        _r5579ded47b = [MagicMock(), MagicMock(), MagicMock()]\n        find_pod_mock.side_effect = [None] + _r5579ded47b\n        self.await_pod_mock.side_effect = AirflowException("oops")\n        _r0224d09f02 = create_context(_rab6e33b737, persist_to_db=True)\n        with pytest.raises(AirflowException):\n            _rab6e33b737.execute(context=_r0224d09f02)\n        mock_patch_already_checked.assert_called_once()\n        mock_delete_pod.assert_not_called()\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize("do_xcom_push", [True, False])\n    @patch(f"{POD_MANAGER_CLASS}.extract_xcom")\n    @patch(f"{POD_MANAGER_CLASS}.await_xcom_sidecar_container_start")\n    def test_wait_for_xcom_sidecar_iff_push_xcom(self, mock_await, mock_extract_xcom, do_xcom_push):\n        """Assert we wait for xcom sidecar container if and only if we push xcom."""\n        mock_extract_xcom.return_value = "{}"\n        mock_await.return_value = None\n        _r420624d088 = KubernetesPodOperator(\n            task_id="task",\n            do_xcom_push=do_xcom_push,\n        )\n        self.run_pod(_r420624d088)\n        if do_xcom_push:\n            mock_await.assert_called_once()\n        else:\n            mock_await.assert_not_called()\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize(\n        ("task_kwargs", "should_fail", "should_be_deleted"),\n        [\n            ({}, False, True),\n            ({}, True, True),\n            ({"on_finish_action": "keep_pod"}, False, False),\n            ({"on_finish_action": "keep_pod"}, True, False),\n            ({"on_finish_action": "delete_pod"}, False, True),\n            ({"on_finish_action": "delete_pod"}, True, True),\n            ({"on_finish_action": "delete_succeeded_pod"}, False, True),\n            ({"on_finish_action": "delete_succeeded_pod"}, True, False),\n            ({"on_finish_action": "delete_active_pod"}, False, False),\n            ({"on_finish_action": "delete_active_pod"}, True, False),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.patch_already_checked")\n    def test_mark_checked_if_not_deleted(\n        self, mock_patch_already_checked, mock_delete_pod, task_kwargs, should_fail, should_be_deleted\n    ):\n        """If we aren\'t deleting pods mark "checked" if the task completes (successful or otherwise)"""\n        _rebd84a1c64 = DAG("hello2", schedule=None, start_date=pendulum.now())\n        _rdd84caae50 = KubernetesPodOperator(\n            task_id="task",\n            dag=_rebd84a1c64,\n            **task_kwargs,\n        )\n        _r72ac10b7d2 = MagicMock()\n        _r72ac10b7d2.status.phase = "Failed" if should_fail else "Succeeded"\n        self.await_pod_mock.return_value = _r72ac10b7d2\n        _r813248d9bb = create_context(_rdd84caae50, persist_to_db=True)\n        if should_fail:\n            with pytest.raises(AirflowException):\n                _rdd84caae50.execute(context=_r813248d9bb)\n        else:\n            _rdd84caae50.execute(context=_r813248d9bb)\n        if should_fail or not should_be_deleted:\n            mock_patch_already_checked.assert_called_once()\n        else:\n            mock_patch_already_checked.assert_not_called()\n        if should_be_deleted:\n            mock_delete_pod.assert_called_once()\n        else:\n            mock_delete_pod.assert_not_called()\n\n    @patch(HOOK_CLASS, new=MagicMock)\n    def test_patch_already_checked(self):\n        """Make sure we patch the pods with the right label"""\n        _r77a751c6e6 = KubernetesPodOperator(task_id="task")\n        _ra8b611caec = _r77a751c6e6.build_pod_request_obj()\n        _r77a751c6e6.patch_already_checked(_ra8b611caec)\n        _r77a751c6e6.client.patch_namespaced_pod.assert_called_once_with(\n            name=_ra8b611caec.metadata.name,\n            namespace=_ra8b611caec.metadata.namespace,\n            body={"metadata": {"labels": {"already_checked": "True"}}},\n        )\n\n    def test_task_id_as_name(self):\n        _r8b79f976bb = KubernetesPodOperator(\n            task_id=".hi.-_09HI",\n            random_name_suffix=False,\n        )\n        _rbdada56c2c = _r8b79f976bb.build_pod_request_obj({})\n        assert _rbdada56c2c.metadata.name == "hi-09hi"\n\n    def test_task_id_as_name_with_suffix(self):\n        _r710b39bb56 = KubernetesPodOperator(\n            task_id=".hi.-_09HI",\n            random_name_suffix=True,\n        )\n        _r2b6c61fd15 = _r710b39bb56.build_pod_request_obj({})\n        _rb49c05ceb7 = "hi-09hi"\n        assert _r2b6c61fd15.metadata.name[: len(_rb49c05ceb7)] == _rb49c05ceb7\n        assert re.match(rf"{_rb49c05ceb7}-[a-z0-9]{{8}}", _r2b6c61fd15.metadata.name) is not None\n\n    def test_task_id_as_name_with_suffix_very_long(self):\n        _r8669890346 = KubernetesPodOperator(\n            task_id="a" * 250,\n            random_name_suffix=True,\n        )\n        _rf5f5d4d1ac = _r8669890346.build_pod_request_obj({})\n        assert (\n            re.match(\n                r"a{54}-[a-z0-9]{8}",\n                _rf5f5d4d1ac.metadata.name,\n            )\n            is not None\n        )\n\n    def test_task_id_as_name_dag_id_is_ignored(self):\n        _rad4f20449f = DAG(dag_id="this_is_a_dag_name", schedule=None, start_date=pendulum.now())\n        _r413f9c97cf = KubernetesPodOperator(\n            task_id="a_very_reasonable_task_name",\n            dag=_rad4f20449f,\n        )\n        _r3d90ea776e = _r413f9c97cf.build_pod_request_obj({})\n        assert re.match(r"a-very-reasonable-task-name-[a-z0-9-]+", _r3d90ea776e.metadata.name) is not None\n\n    @pytest.mark.parametrize(\n        ("labels", "expected"),\n        [\n            pytest.param({}, {}, id="empty"),\n            pytest.param(\n                {"a": None, "b": "value", "c": None}, {"a": "", "b": "value", "c": ""}, id="with-none"\n            ),\n            pytest.param(\n                {"empty_str": "", "zero": 0, "false": False, "none": None},\n                {"empty_str": "", "zero": 0, "false": False, "none": ""},\n                id="preserve-other-values",\n            ),\n        ],\n    )\n    def test_normalize_labels_dict(self, labels, expected):\n        """normalize_labels_dict should transform only None values to empty strings and preserve others"""\n        from airflow.providers.cncf.kubernetes.operators.pod import _normalize_labels_dict\n\n        _rfddf53e9bd = _normalize_labels_dict(labels)\n        assert _rfddf53e9bd == expected\n\n    @patch(f"{POD_MANAGER_CLASS}.extract_xcom")\n    @patch(f"{POD_MANAGER_CLASS}.await_xcom_sidecar_container_start")\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    def test_xcom_push_failed_pod(self, remote_pod, mock_await, mock_extract_xcom):\n        """Tests that an xcom is pushed after a pod failed but xcom output exists."""\n        _r28a87b0f37 = KubernetesPodOperator(task_id="task", on_finish_action="delete_pod", do_xcom_push=True)\n\n        remote_pod.return_value.status.phase = "Failed"\n        mock_extract_xcom.return_value = \'{"Test key": "Test value"}\'\n        _rd69178f55d = create_context(_r28a87b0f37)\n        _rd69178f55d["ti"].xcom_push = MagicMock()\n\n        with pytest.raises(AirflowException):\n            _r28a87b0f37.execute(context=_rd69178f55d)\n\n        _rd69178f55d["ti"].xcom_push.assert_called_with(XCOM_RETURN_KEY, {"Test key": "Test value"})\n\n    @patch(f"{POD_MANAGER_CLASS}.extract_xcom")\n    @patch(f"{POD_MANAGER_CLASS}.await_xcom_sidecar_container_start")\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    def test_xcom_push_failed_pod_fans_out_for_multiple_outputs(\n        self, remote_pod, mock_await, mock_extract_xcom\n    ):\n        """On the sync failure path, ``multiple_outputs=True`` must fan the sidecar dict out\n        into per-key XComs in addition to the ``return_value`` push — matching the task runner\n        behaviour applied on the success path.\n        """\n        _r3015dab9cd = KubernetesPodOperator(\n            task_id="task", on_finish_action="delete_pod", do_xcom_push=True, multiple_outputs=True\n        )\n\n        remote_pod.return_value.status.phase = "Failed"\n        _rf7d55880de = {"export_arn": "arn:aws:dynamodb:::export/x", "s3_uri": "s3://b/p"}\n        mock_extract_xcom.return_value = json.dumps(_rf7d55880de)\n        _rc26d76f812 = create_context(_r3015dab9cd)\n        _rc26d76f812["ti"].xcom_push = MagicMock()\n\n        with pytest.raises(AirflowException):\n            _r3015dab9cd.execute(context=_rc26d76f812)\n\n        _rc26d76f812["ti"].xcom_push.assert_any_call("export_arn", "arn:aws:dynamodb:::export/x")\n        _rc26d76f812["ti"].xcom_push.assert_any_call("s3_uri", "s3://b/p")\n        _rc26d76f812["ti"].xcom_push.assert_any_call(XCOM_RETURN_KEY, _rf7d55880de)\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize(\n        ("kwargs", "actual_exit_code", "expected_exc"),\n        [\n            ({}, 0, None),\n            ({}, 100, AirflowException),\n            ({}, 101, AirflowException),\n            ({"skip_on_exit_code": None}, 0, None),\n            ({"skip_on_exit_code": None}, 100, AirflowException),\n            ({"skip_on_exit_code": None}, 101, AirflowException),\n            ({"skip_on_exit_code": 100}, 0, None),\n            ({"skip_on_exit_code": 100}, 100, AirflowSkipException),\n            ({"skip_on_exit_code": 100}, 101, AirflowException),\n            ({"skip_on_exit_code": 0}, 0, AirflowSkipException),\n            ({"skip_on_exit_code": [100]}, 0, None),\n            ({"skip_on_exit_code": [100]}, 100, AirflowSkipException),\n            ({"skip_on_exit_code": [100]}, 101, AirflowException),\n            ({"skip_on_exit_code": [100, 102]}, 101, AirflowException),\n            ({"skip_on_exit_code": (100,)}, 0, None),\n            ({"skip_on_exit_code": (100,)}, 100, AirflowSkipException),\n            ({"skip_on_exit_code": (100,)}, 101, AirflowException),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    def test_task_skip_when_pod_exit_with_certain_code(\n        self, remote_pod, kwargs, actual_exit_code, expected_exc\n    ):\n        """Tests that an AirflowSkipException is raised when the container exits with the skip_on_exit_code"""\n        _rd4b2107f3d = KubernetesPodOperator(task_id="task", on_finish_action="delete_pod", **kwargs)\n\n        _rbb89c5710b = MagicMock()\n        _rbb89c5710b.name = _rd4b2107f3d.base_container_name\n        _rbb89c5710b.state.terminated.exit_code = actual_exit_code\n        _r779aa8dd5d = MagicMock()\n        _r779aa8dd5d.name = "airflow-xcom-sidecar"\n        _r779aa8dd5d.state.terminated.exit_code = 0\n        remote_pod.return_value.status.container_statuses = [_rbb89c5710b, _r779aa8dd5d]\n        remote_pod.return_value.status.phase = "Succeeded" if actual_exit_code == 0 else "Failed"\n\n        if expected_exc is None:\n            self.run_pod(_rd4b2107f3d)\n        else:\n            with pytest.raises(expected_exc):\n                self.run_pod(_rd4b2107f3d)\n\n    @pytest.mark.asyncio\n    @patch(f"{POD_MANAGER_CLASS}.extract_xcom")\n    @patch(f"{POD_MANAGER_CLASS}.await_xcom_sidecar_container_start")\n    @patch(f"{POD_MANAGER_CLASS}.await_container_completion")\n    @patch(f"{POD_MANAGER_CLASS}.fetch_requested_container_logs")\n    @patch(HOOK_CLASS)\n    def test_get_logs_but_not_for_base_container(\n        self,\n        hook_mock,\n        mock_fetch_log,\n        mock_await_container_completion,\n        mock_await_xcom_sidecar,\n        mock_extract_xcom,\n    ):\n        hook_mock.return_value.get_xcom_sidecar_container_image.return_value = None\n        hook_mock.return_value.get_xcom_sidecar_container_resources.return_value = None\n        hook_mock.return_value.get_xcom_sidecar_container_security_context.return_value = None\n        _rf6c8252c43 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            labels={"foo": "bar"},\n            name="test",\n        