e": "some transient error",\n            "name": TEST_NAME,\n            "namespace": TEST_NAMESPACE,\n            "_redefer_count": _r478f6eed66.MAX_REDEFER_ATTEMPTS,\n        }\n\n        with pytest.raises(AirflowException):\n            _r478f6eed66.trigger_reentry(_r066ced784a, _r713bc20980)\n\n        mock_invoke_defer.assert_not_called()\n\n    @patch(KUB_OP_PATH.format("invoke_defer_method"))\n    @patch(HOOK_CLASS)\n    def test_redefer_increments_count(self, mocked_hook, mock_invoke_defer):\n        """Re-defer count is incremented in trigger_kwargs for each re-defer."""\n        mock_invoke_defer.side_effect = TaskDeferred(trigger=MagicMock(), method_name="trigger_reentry")\n\n        _r2bdca9df5b = MagicMock()\n        _r2bdca9df5b.name = "base"\n        _r2bdca9df5b.state.running = MagicMock()\n        _r2bdca9df5b.state.terminated = None\n        _r2bdca9df5b.state.waiting = None\n\n        _r35b027b377 = MagicMock()\n        _r35b027b377.status.phase = "Running"\n        _r35b027b377.status.container_statuses = [_r2bdca9df5b]\n        mocked_hook.return_value.get_pod.return_value = _r35b027b377\n\n        _r95d7b1ecb6 = KubernetesPodOperator(task_id="test_task", name="test-pod", deferrable=True)\n        _r14d12524a9 = create_context(_r95d7b1ecb6)\n        _rdbbae06e61 = {\n            "status": "error",\n            "message": "transient error",\n            "name": TEST_NAME,\n            "namespace": TEST_NAMESPACE,\n            "_redefer_count": 2,\n        }\n\n        with pytest.raises(TaskDeferred):\n            _r95d7b1ecb6.trigger_reentry(_r14d12524a9, _rdbbae06e61)\n\n        assert _r95d7b1ecb6.trigger_kwargs["_redefer_count"] == 3\n        mock_invoke_defer.assert_called_once()\n\n    @patch(KUB_OP_PATH.format("post_complete_action"))\n    @patch(KUB_OP_PATH.format("pod_manager"))\n    @patch(HOOK_CLASS)\n    def test_error_event_treated_as_success_when_container_succeeded(\n        self, mocked_hook, mock_manager, mock_post_complete\n    ):\n        """When trigger emits error but container actually exited 0, treat as success."""\n        _rc5ba82881f = MagicMock()\n        _rc5ba82881f.name = "base"\n        _rc5ba82881f.state.terminated = MagicMock()\n        _rc5ba82881f.state.terminated.exit_code = 0\n        _rc5ba82881f.state.running = None\n        _rc5ba82881f.state.waiting = None\n\n        _r58a298775b = MagicMock()\n        _r58a298775b.status.phase = "Succeeded"\n        _r58a298775b.status.container_statuses = [_rc5ba82881f]\n        _r58a298775b.status.init_container_statuses = None\n        mocked_hook.return_value.get_pod.return_value = _r58a298775b\n        mock_manager.await_pod_completion.return_value = _r58a298775b\n\n        _rdfcfac8e2a = KubernetesPodOperator(task_id="test_task", name="test-pod", deferrable=True, get_logs=False)\n        _r8f6de91c60 = create_context(_rdfcfac8e2a)\n        _r8f6de91c60["ti"] = MagicMock()\n        _r12e1652db2 = {\n            "status": "error",\n            "message": "API timeout",\n            "name": TEST_NAME,\n            "namespace": TEST_NAMESPACE,\n        }\n\n        # Should NOT raise — treated as success\n        _rdfcfac8e2a.trigger_reentry(_r8f6de91c60, _r12e1652db2)\n\n        mock_post_complete.assert_called_once()\n\n    @patch(HOOK_CLASS)\n    def test_execute_async_callbacks(self, mocked_hook):\n        from airflow.providers.cncf.kubernetes.callbacks import ExecutionMode\n\n        from unit.cncf.kubernetes.test_callbacks import (\n            MockKubernetesPodOperatorCallback,\n            MockWrapper,\n        )\n\n        MockWrapper.reset()\n        _r4741762070 = MockWrapper.mock_callbacks\n        _r324ba8b331 = MagicMock()\n        _r324ba8b331.status.phase = "Succeeded"\n        self.await_pod_mock.return_value = _r324ba8b331\n        mocked_hook.return_value.get_pod.return_value = _r324ba8b331\n\n        _r483faae400 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n            callbacks=MockKubernetesPodOperatorCallback,\n        )\n        _r86962ffc22 = create_context(_r483faae400)\n\n        _r5907508326 = {\n            "status": "success",\n            "message": TEST_SUCCESS_MESSAGE,\n            "name": TEST_NAME,\n            "namespace": TEST_NAMESPACE,\n        }\n        _r483faae400.trigger_reentry(context=_r86962ffc22, event=_r5907508326)\n\n        # check on_pod_cleanup callback\n        _r4741762070.on_pod_cleanup.assert_called_once()\n        assert _r4741762070.on_pod_cleanup.call_args.kwargs == {\n            "client": _r483faae400.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r324ba8b331,\n            "operator": _r483faae400,\n            "context": _r86962ffc22,\n        }\n\n        # check on_pod_completion callback\n        _r4741762070.on_pod_completion.assert_called_once()\n        assert _r4741762070.on_pod_completion.call_args.kwargs == {\n            "client": _r483faae400.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r324ba8b331,\n            "operator": _r483faae400,\n            "context": _r86962ffc22,\n        }\n\n        # check on_pod_teardown callback\n        _r4741762070.on_pod_teardown.assert_called_once()\n        assert _r4741762070.on_pod_teardown.call_args.kwargs == {\n            "client": _r483faae400.client,\n            "mode": ExecutionMode.SYNC,\n            "pod": _r324ba8b331,\n            "operator": _r483faae400,\n            "context": _r86962ffc22,\n        }\n\n    @patch(KUB_OP_PATH.format("client"))\n    @patch(KUB_OP_PATH.format("find_pod"))\n    @patch(KUB_OP_PATH.format("build_pod_request_obj"))\n    @patch(KUB_OP_PATH.format("get_or_create_pod"))\n    @patch(KUB_OP_PATH.format("trigger_reentry"))\n    def test_skip_deferral_on_terminated_pod(\n        self,\n        mocked_trigger_reentry,\n        mocked_get_or_create_pod,\n        mocked_build_pod_request_obj,\n        mocked_find_pod,\n        mocked_client,\n        mocker,\n    ):\n        _r6c9c6e4407 = KubernetesPodOperator(\n            task_id=TEST_TASK_ID,\n            namespace=TEST_NAMESPACE,\n            image=TEST_IMAGE,\n            cmds=TEST_CMDS,\n            arguments=TEST_ARGS,\n            labels=TEST_LABELS,\n            name=TEST_NAME,\n            in_cluster=True,\n            get_logs=True,\n            deferrable=True,\n        )\n        _rc88f7d3a55 = mock_open(read_data=\'{"a": "b"}\')\n        mocker.patch("builtins.open", _rc88f7d3a55)\n\n        mocked_find_pod.return_value.metadata.name = TEST_NAME\n        mocked_find_pod.return_value.metadata.namespace = TEST_NAMESPACE\n        mocked_get_or_create_pod.return_value.status.container_statuses = [\n            k8s.V1ContainerStatus(\n                name=_r6c9c6e4407.base_container_name,\n                state=k8s.V1ContainerState(terminated=k8s.V1ContainerStateTerminated(exit_code=0)),\n                image="alpine",\n                image_id="",\n                ready=False,\n                restart_count=0,\n            )\n        ]\n\n        _r73579bb041 = create_context(_r6c9c6e4407)\n        _r87f09384f0 = MagicMock(**{"map_index": -1})\n        _r73579bb041["ti"] = _r87f09384f0\n\n        _r6c9c6e4407.execute(_r73579bb041)\n        mocked_trigger_reentry.assert_called_once()\n\n    @patch(POD_MANAGER_CLASS)\n    @patch(HOOK_CLASS)\n    def test_async_trigger_reentry_returns_when_pod_gcd_on_success(self, mocked_hook, mock_manager):\n        """Pod GC\'d between trigger firing and reentry should not fail a successful task."""\n        mocked_hook.return_value.get_pod.side_effect = ApiException(status=404, reason="Not Found")\n        _rde966ef45e = KubernetesPodOperator(task_id="task", deferrable=True)\n        _re958c28c35 = create_context(_rde966ef45e)\n        _re958c28c35["ti"] = MagicMock()\n\n        # Should return cleanly without raising\n        _r5a7ce0b7c1 = _rde966ef45e.trigger_reentry(\n            context=_re958c28c35,\n            event={\n                "status": "success",\n                "message": TEST_SUCCESS_MESSAGE,\n                "name": TEST_NAME,\n                "namespace": TEST_NAMESPACE,\n            },\n        )\n\n        assert _r5a7ce0b7c1 is None\n        # await_pod_completion in _clean must not be called with self.pod=None\n        mock_manager.return_value.await_pod_completion.assert_not_called()\n\n    @patch(POD_MANAGER_CLASS)\n    @patch(HOOK_CLASS)\n    def test_async_trigger_reentry_raises_pod_not_found_on_failure(self, mocked_hook, mock_manager):\n        """Pod GC\'d before reentry on a failed event surfaces as PodNotFoundException."""\n        mocked_hook.return_value.get_pod.side_effect = ApiException(status=404, reason="Not Found")\n        _r096db706ad = KubernetesPodOperator(task_id="task", deferrable=True)\n        _r7e682635ac = create_context(_r096db706ad)\n        _r7e682635ac["ti"] = MagicMock()\n\n        with pytest.raises(PodNotFoundException):\n            _r096db706ad.trigger_reentry(\n                context=_r7e682635ac,\n                event={\n                    "status": "failed",\n                    "message": "Some failure",\n                    "name": TEST_NAME,\n                    "namespace": TEST_NAMESPACE,\n                },\n            )\n\n    @patch(POD_MANAGER_CLASS)\n    @patch(HOOK_CLASS)\n    def test_async_trigger_reentry_propagates_non_404_api_exception(self, mocked_hook, mock_manager):\n        """Non-404 ApiException from get_pod should propagate unchanged."""\n        mocked_hook.return_value.get_pod.side_effect = ApiException(status=500, reason="Server Error")\n        _rc0068b309e = KubernetesPodOperator(task_id="task", deferrable=True)\n        _red24a548ee = create_context(_rc0068b309e)\n        _red24a548ee["ti"] = MagicMock()\n\n        with pytest.raises(ApiException) as _red8aa1fdcf:\n            _rc0068b309e.trigger_reentry(\n                context=_red24a548ee,\n                event={\n                    "status": "success",\n                    "message": TEST_SUCCESS_MESSAGE,\n                    "name": TEST_NAME,\n                    "namespace": TEST_NAMESPACE,\n                },\n            )\n        assert _red8aa1fdcf.value.status == 500\n\n\n@pytest.mark.parametrize("do_xcom_push", [True, False])\n@patch(KUB_OP_PATH.format("extract_xcom"))\n@patch(KUB_OP_PATH.format("post_complete_action"))\n@patch(HOOK_CLASS)\ndef test_async_kpo_wait_termination_before_cleanup_on_success(\n    mocked_hook, post_complete_action, mock_extract_xcom, do_xcom_push\n):\n    _r1143679050 = {"metadata.name": TEST_NAME, "metadata.namespace": TEST_NAMESPACE}\n    _rfafd0be82f = mock.MagicMock(**_r1143679050, **{"status.phase": "Running"})\n    _rbe33219518 = mock.MagicMock(**_r1143679050, **{"status.phase": "Succeeded"})\n    mocked_hook.return_value.get_pod.return_value = _rfafd0be82f\n    _rc557ed3b8d = mocked_hook.return_value.core_v1_client.read_namespaced_pod\n    _rc557ed3b8d.side_effect = [\n        _rfafd0be82f,\n        _rfafd0be82f,\n        _rbe33219518,\n    ]\n\n    _r2c9e3a6c30 = {\n        "status": "success",\n        "message": TEST_SUCCESS_MESSAGE,\n        "name": TEST_NAME,\n        "namespace": TEST_NAMESPACE,\n    }\n\n    _r13aee8d75a = KubernetesPodOperator(task_id="task", deferrable=True, do_xcom_push=do_xcom_push)\n    _rf0d6c69ae0 = create_context(_r13aee8d75a)\n    _rf0d6c69ae0["ti"].xcom_push = MagicMock()\n\n    _r640db468bb = _r13aee8d75a.trigger_reentry(_rf0d6c69ae0, _r2c9e3a6c30)\n\n    # check if it gets the pod\n    mocked_hook.return_value.get_pod.assert_called_once_with(TEST_NAME, TEST_NAMESPACE)\n\n    if do_xcom_push:\n        mock_extract_xcom.assert_called_once()\n        assert _r640db468bb == mock_extract_xcom.return_value\n        _rf0d