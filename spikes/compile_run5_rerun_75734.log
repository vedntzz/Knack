    anchored on ``ti.start_date`` and propagated to the trigger via\n        ``trigger_kwargs``. ``defer.timeout`` covers the remaining budget plus\n        a poll-interval buffer so the framework backstop doesn\'t race the\n        trigger.\n        """\n        mocked_get_connection.side_effect = AirflowNotFoundException("connection not found")\n\n        _rfad979c25a = datetime.timedelta(seconds=300)\n        _r4869b4f141 = KubernetesPodOperator(\n            task_id=TEST_TASK_ID,\n            namespace=TEST_NAMESPACE,\n            image=TEST_IMAGE,\n            name=TEST_NAME,\n            on_finish_action="keep_pod",\n            in_cluster=True,\n            deferrable=True,\n            execution_timeout=_rfad979c25a,\n        )\n        # Skip the pod-creation path and pretend it\'s already running.\n        _r4869b4f141.pod = MagicMock()\n        _r4869b4f141.pod.metadata.name = TEST_NAME\n        _r4869b4f141.pod.metadata.namespace = TEST_NAMESPACE\n\n        _r7f99cbc915 = MagicMock()\n        _rd2b3d8b776 = datetime.datetime(2026, 1, 1, 12, 0, 0, tzinfo=datetime.UTC)\n        _r7f99cbc915.start_date = _rd2b3d8b776\n        _r9bd921a8e4 = {"ti": _r7f99cbc915}\n\n        # Freeze at ``ti_start + 30s`` → remaining=270s. ``defer.timeout`` =\n        # remaining + max(60, poll_interval * 2) = 270 + 60 = 330s for default\n        # poll_interval=2.\n        _rb56bb944df = datetime.timedelta(seconds=30)\n        with (\n            time_machine.travel(_rd2b3d8b776 + _rb56bb944df, tick=False),\n            patch(f"{TRIGGER_CLASS}.define_pod_container_state", return_value=ContainerState.RUNNING),\n            pytest.raises(TaskDeferred) as _raa5541f344,\n        ):\n            _r4869b4f141.invoke_defer_method(context=_r9bd921a8e4)\n\n        _rcf777f9e15 = _raa5541f344.value.trigger\n        assert isinstance(_rcf777f9e15, KubernetesPodTrigger)\n        _rc50b55b140 = int((_rd2b3d8b776 + _rfad979c25a).timestamp())\n        assert _rcf777f9e15.trigger_kwargs["_execution_deadline"] == _rc50b55b140\n        assert _raa5541f344.value.timeout == datetime.timedelta(seconds=270 + 60)\n\n    @patch(KUB_OP_PATH.format("convert_config_file_to_dict"))\n    @patch("airflow.providers.cncf.kubernetes.operators.pod.BaseHook.get_connection")\n    def test_invoke_defer_method_pads_defer_timeout_for_slow_poll_interval(\n        self, mocked_get_connection, mocked_convert_config\n    ):\n        """\n        With a slow ``poll_interval`` (e.g. 60s), ``defer.timeout`` is padded\n        by ``poll_interval * 2`` so the framework backstop doesn\'t preempt the\n        trigger before it can emit its own ``status="timeout"`` event from the\n        next poll cycle.\n        """\n        mocked_get_connection.side_effect = AirflowNotFoundException("connection not found")\n\n        _rb6b959d70f = datetime.timedelta(seconds=30)\n        _rbb22ff6052 = KubernetesPodOperator(\n            task_id=TEST_TASK_ID,\n            namespace=TEST_NAMESPACE,\n            image=TEST_IMAGE,\n            name=TEST_NAME,\n            on_finish_action="keep_pod",\n            in_cluster=True,\n            deferrable=True,\n            execution_timeout=_rb6b959d70f,\n            poll_interval=60,\n        )\n        _rbb22ff6052.pod = MagicMock()\n        _rbb22ff6052.pod.metadata.name = TEST_NAME\n        _rbb22ff6052.pod.metadata.namespace = TEST_NAMESPACE\n\n        _r8d13222df6 = MagicMock()\n        _re0b83ab109 = datetime.datetime(2026, 1, 1, 12, 0, 0, tzinfo=datetime.UTC)\n        _r8d13222df6.start_date = _re0b83ab109\n        _r91ebf6d4c3 = {"ti": _r8d13222df6}\n\n        # Freeze at ``ti_start`` → remaining=30s. ``defer.timeout`` =\n        # remaining + max(60, poll_interval * 2) = 30 + 120 = 150s.\n        with (\n            time_machine.travel(_re0b83ab109, tick=False),\n            patch(f"{TRIGGER_CLASS}.define_pod_container_state", return_value=ContainerState.RUNNING),\n            pytest.raises(TaskDeferred) as _r9777964a19,\n        ):\n         