ls):\n        _r0949e0e43f = KubernetesPodOperator(\n            task_id="task",\n            name="test",\n            namespace="default",\n            log_events_on_startup=log_events_on_startup,\n        )\n        _r0949e0e43f.await_pod_start(k8s.V1Pod(metadata=k8s.V1ObjectMeta(name="pod", namespace="default")))\n\n        assert self.watch_pod_events_mock.call_count == expected_calls\n\n    @patch(KUB_OP_PATH.format("convert_config_file_to_dict"), autospec=True)\n    @patch("airflow.providers.cncf.kubernetes.operators.pod.BaseHook.get_connection", autospec=True)\n    @patch(f"{TRIGGER_CLASS}.define_pod_container_state", autospec=True, return_value=ContainerState.RUNNING)\n    def test_invoke_defer_method_passes_log_events_on_startup_to_trigger(\n        self, mock_container_state, mocked_get_connection, mocked_convert_config\n    ):\n        mocked_get_connection.side_effect = AirflowNotFoundException("connection not found")\n        _rdc0a0d1b3f = KubernetesPodOperator(\n            task_id=TEST_TASK_ID,\n            namespace=TEST_NAMESPACE,\n            image=TEST_IMAGE,\n            name=TEST_NAME,\n            in_cluster=True,\n            deferrable=True,\n            log_events_on_startup=False,\n        )\n        _rdc0a0d1b3f.pod = k8s.V1Pod(metadata=k8s.V1ObjectMeta(name=TEST_NAME, namespace=TEST_NAMESPACE))\n\n        with pytest.raises(TaskDeferred) as _r5b2a15912b:\n            _rdc0a0d1b3f.invoke_defer_method()\n\n        assert _r5b2a15912b.value.trigger.serialize()[1]["log_events_on_startup"] is False\n\n    def test_templates(self, create_task_instance_of_operator, session):\n        _ra7cbfa5802 = "TestKubernetesPodOperator"\n        _r1fc3de3113 = create_task_instance_of_operator(\n            KubernetesPodOperator,\n            session=session,\n            dag_id=_ra7cbfa5802,\n            task_id="task-id",\n            name="{{ dag.dag_id }}",\n            hostname="{{ dag.dag_id }}",\n            base_container_name="{{ dag.dag_id }}",\n            namespace="{{ dag.dag_id }}",\n            container_resources=k8s.V1ResourceRequirements(\n                requests={"memory": "{{ dag.dag_id }}", "cpu": "{{ dag.dag_id }}"},\n                limits={"memory": "{{ dag.dag_id }}", "cpu": "{{ dag.dag_id }}"},\n            ),\n            volume_mounts=[\n                k8s.V1VolumeMount(\n                    name="{{ dag.dag_id }}",\n                    mount_path="mount_path",\n                    sub_path="{{ dag.dag_id }}",\n                )\n            ],\n            pod_template_file="{{ dag.dag_id }}",\n            config_file="{{ dag.dag_id }}",\n            labels="{{ dag.dag_id }}",\n            env_vars=["{{ dag.dag_id }}"],\n            arguments="{{ dag.dag_id }}",\n            cmds="{{ dag.dag_id }}",\n            image="{{ dag.dag_id }}",\n            annotations={"dag-id": "{{ dag.dag_id }}"},\n            configmaps=["{{ dag.dag_id }}"],\n            volumes=[\n                k8s.V1Volume(\n                    name="{{ dag.dag_id }}",\n                    config_map=k8s.V1ConfigMapVolumeSource(\n                        name="{{ dag.dag_id }}", items=[k8s.V1KeyToPath(key="key", path="path")]\n                    ),\n                )\n            ],\n        )\n\n        session.add(_r1fc3de3113)\n        session.commit()\n        _r3b26813a0b = _r1fc3de3113.render_templates()\n\n        assert _ra7cbfa5802 == _r3b26813a0b.container_resources.limits["memory"]\n        assert _ra7cbfa5802 == _r3b26813a0b.container_resources.limits["cpu"]\n        assert _ra7cbfa5802 == _r3b26813a0b.container_resources.requests["memory"]\n        assert _ra7cbfa5802 == _r3b26813a0b.container_resources.requests["cpu"]\n        assert _ra7cbfa5802 == _r3b26813a0b.volume_mounts[0].name\n        assert _ra7cbfa5802 == _r3b26813a0b.volume_mounts[0].sub_path\n        assert _ra7cbfa5802 == _r3b26813a0b.image\n        assert _ra7cbfa5802 == _r3b26813a0b.cmds\n        assert _ra7cbfa5802 == _r3b26813a0b.name\n        assert _ra7cbfa5802 == _r3b26813a0b.hostname\n        assert _ra7cbfa5802 == _r3b26813a0b.base_container_name\n        assert _ra7cbfa5802 == _r3b26813a0b.namespace\n        assert _ra7cbfa5802 == _r3b26813a0b.config_file\n        assert _ra7cbfa5802 == _r3b26813a0b.labels\n        assert _ra7cbfa5802 == _r3b26813a0b.pod_template_file\n        assert _ra7cbfa5802 == _r3b26813a0b.arguments\n        assert _ra7cbfa5802 == _r3b26813a0b.env_vars[0]\n        assert _ra7cbfa5802 == _r3b26813a0b.annotations["dag-id"]\n        assert [_ra7cbfa5802] == _r3b26813a0b.configmaps\n        assert _ra7cbfa5802 == _r3b26813a0b.volumes[0].name\n        assert _ra7cbfa5802 == _r3b26813a0b.volumes[0].config_map.name\n\n    def run_pod(self, operator: KubernetesPodOperator, map_index: int = -1) -> tuple[k8s.V1Pod, Context]:\n        with self.dag_maker(dag_id="dag") as _r8bb1b3db5d:\n            operator.dag = _r8bb1b3db5d\n\n        _r0197f7d88c = self.dag_maker.create_dagrun(run_id="test")\n        (_rbea776e90e,) = _r0197f7d88c.task_instances\n        _rbea776e90e.map_index = map_index\n        self.dag_run = _r0197f7d88c\n        _ra212c9ad1d = get_template_context(_rbea776e90e, operator, session=self.dag_maker.session)\n        self.dag_maker.session.commit()  # So \'execute\' can read dr and ti.\n\n        _ree68d42ee9 = MagicMock()\n        _ree68d42ee9.status.phase = "Succeeded"\n        _ra3baf0db22 = MagicMock()\n        _ra3baf0db22.name = operator.base_container_name\n        _ra3baf0db22.state.terminated.exit_code = 0\n        _ree68d42ee9.status.container_statuses = [_ra3baf0db22]\n        _ree68d42ee9.status.init_container_statuses = None\n        self.await_pod_mock.return_value = _ree68d42ee9\n        operator.execute(context=_ra212c9ad1d)\n        return self.await_start_mock.call_args.kwargs["pod"], _ra212c9ad1d\n\n    def sanitize_for_serialization(self, obj):\n        return ApiClient().sanitize_for_serialization(obj)\n\n    @patch(HOOK_CLASS)\n    def test_config_path(self, hook_mock):\n        _rc21a637bb7 = "/tmp/fake_file"\n        _r990c783423 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n            config_file=_rc21a637bb7,\n        )\n        _r08b230aead = MagicMock()\n        _r08b230aead.status.phase = "Succeeded"\n        self.await_pod_mock.return_value = _r08b230aead\n        self.run_pod(_r990c783423)\n        hook_mock.assert_called_once_with(\n            cluster_context=None,\n            conn_id="kubernetes_default",\n            config_file=_rc21a637bb7,\n            in_cluster=None,\n        )\n\n    @pytest.mark.parametrize(\n        ("input", "render_template_as_native_obj", "raises_error"),\n        [\n            pytest.param([k8s.V1EnvVar(name="{{ bar }}", value="{{ foo }}")], False, False, id="current"),\n            pytest.param({"{{ bar }}": "{{ foo }}"}, False, False, id="backcompat"),\n            pytest.param("{{ env }}", True, False, id="xcom_args"),\n            pytest.param("bad env", False, True, id="error"),\n        ],\n    )\n    def test_env_vars(self, input, render_template_as_native_obj, raises_error):\n        _r9af0af14ba = DAG(\n            dag_id="dag",\n            schedule=None,\n            start_date=pendulum.now(),\n            render_template_as_native_obj=render_template_as_native_obj,\n        )\n        _rbe2b0adecd = KubernetesPodOperator(\n            env_vars=input,\n            task_id="task",\n            name="test",\n            dag=_r9af0af14ba,\n        )\n        _rbe2b0adecd.render_template_fields(\n            context={"foo": "footemplated", "bar": "bartemplated", "env": {"bartemplated": "footemplated"}}\n        )\n        if raises_error:\n            with pytest.raises(AirflowException):\n                _rbe2b0adecd.build_pod_request_obj()\n        else:\n            _rbe2b0adecd.build_pod_request_obj()\n            assert _rbe2b0adecd.env_vars[0].name == "bartemplated"\n            assert _rbe2b0adecd.env_vars[0].value == "footemplated"\n\n    def test_pod_runtime_info_envs(self):\n        _r535c442674 = KubernetesPodOperator(\n            task_id="task",\n            name="test",\n            pod_runtime_info_envs=[k8s.V1EnvVar(name="bar", value="foo")],\n        )\n        _r535c442674.build_pod_request_obj()\n\n        assert _r535c442674.env_vars[0].name == "bar"\n        assert _r535c442674.env_vars[0].value == "foo"\n\n    def test_security_context(self):\n        _re7e17bbb09 = V1PodSecurityContext(run_as_user=1245)\n        _r0ef6deb103 = KubernetesPodOperator(\n            security_context=_re7e17bbb09,\n            task_id="task",\n        )\n        _rfa54f92d69 = _r0ef6deb103.build_pod_request_obj(create_context(_r0ef6deb103))\n        assert _rfa54f92d69.spec.security_context == _re7e17bbb09\n\n    def test_host_aliases(self):\n        _r423b941613 = [k8s.V1HostAlias(ip="192.0.2.1", hostnames=["my.service.com"])]\n        _r2c727c8732 = KubernetesPodOperator(\n            host_aliases=_r423b941613,\n            task_id="task",\n        )\n        _r07a538e5a7 = _r2c727c8732.build_pod_request_obj(create_context(_r2c727c8732))\n        assert _r07a538e5a7.spec.host_aliases == _r423b941613\n\n    def test_container_security_context(self):\n        _r4de107ed37 = {"allowPrivilegeEscalation": False}\n        _r406ff4eacc = KubernetesPodOperator(\n            container_security_context=_r4de107ed37,\n            task_id="task",\n        )\n        _r7efe5f82ad = _r406ff4eacc.build_pod_request_obj(create_context(_r406ff4eacc))\n        assert _r7efe5f82ad.spec.containers[0].security_context == _r4de107ed37\n\n    def test_envs_from_configmaps(self):\n        _r9cf4ce27c4 = [k8s.V1EnvFromSource(config_map_ref=k8s.V1ConfigMapEnvSource(name="test-config-map"))]\n        _ra74557ee89 = KubernetesPodOperator(\n            task_id="task",\n            env_from=_r9cf4ce27c4,\n        )\n        _r730fb3cb98 = _ra74557ee89.build_pod_request_obj(create_context(_ra74557ee89))\n        assert _r730fb3cb98.spec.containers[0].env_from == _r9cf4ce27c4\n\n    def test_envs_from_configmaps_backcompat(self):\n        # todo: formally deprecate / remove this?\n        _rd71ad4110b = KubernetesPodOperator(\n            task_id="task",\n            configmaps=["test-config-map"],\n        )\n        _raf2883561d = [k8s.V1EnvFromSource(config_map_ref=k8s.V1ConfigMapEnvSource(name="test-config-map"))]\n        _rdb7ed64c4c = _rd71ad4110b.build_pod_request_obj(create_context(_rd71ad4110b))\n        assert _rdb7ed64c4c.spec.containers[0].env_from == _raf2883561d\n\n    def test_envs_from_templated_configmaps(self):\n        _r2e3b2a55e5 = [k8s.V1EnvFromSource(config_map_ref=k8s.V1ConfigMapEnvSource(name="from-env-from"))]\n        _r9dea2620dd = KubernetesPodOperator(\n            task_id="task",\n            env_from=_r2e3b2a55e5,\n            configmaps="{{ maps }}",\n            dag=DAG(\n                dag_id="dag",\n                schedule=None,\n                start_date=pendulum.now(),\n                render_template_as_native_obj=True,\n            ),\n        )\n        _r9dea2620dd.render_template_fields(context={"maps": ["from-configmaps"]})\n        _r11dc25beec = _r9dea2620dd.build_pod_request_obj(create_context(_r9dea2620dd))\n        assert _r11dc25beec.spec.containers[0].env_from == [\n            *_r2e3b2a55e5,\n            k8s.V1EnvFromSource(config_map_ref=k8s.V1ConfigMapEnvSource(name="from-configmaps")),\n        ]\n\n    def test_templated_volumes_are_converted_after_rendering(self):\n        _r65ed9c5f81 = k8s.V1Volume(name="vol", empty_dir=k8s.V1EmptyDirVolumeSource())\n        _r3b7e594204 = k8s.V1VolumeMount(name="vol", mount_path="/mnt")\n        _r59c7ed4149 = KubernetesPodOperator(\n            task_id="task",\n            volumes="{{ vols }}",\n            volume_mounts="{{ mounts }}",\n            dag=DAG(\n                dag_id="dag",\n                schedule=None,\n                start_date=pendulum.now(),\n                render_template_as_native_obj=True,\n            ),\n        )\n        _r59c7ed4149.render_template_fields(context={"vols": [_r65ed9c5f81], "mounts": [_r3b7e594204]})\n        _r1137af3bb3 = _r59c7ed4149.build_pod_request_obj(create_context(_r59c7ed4149))\n        assert _r1137af3bb3.spec.volumes == [_r65ed9c5f81]\n        assert _r1137af3bb3.spec.containers[0].volume_mounts == [_r3b7e594204]\n\n    def test_env_vars_rendered_for_mapped_task(self):\n        with DAG(dag_id="dag", schedule=None, start_date=pendulum.now()):\n            _rf8887437e7 = KubernetesPodOperator.partial(task_id="task", name="test").expand(\n                env_vars=[{"{{ bar }}": "{{ foo }}"}]\n            )\n        _r96fa4475bc = create_context(_rf8887437e7, map_index=0)\n        _r96fa4475bc.update({"dag_run": _r96fa4475bc["ti"].dag_run, "foo": "footemplated", "bar": "bartemplated"})\n\n        with task_instance_session():\n            _rf8887437e7.render_template_fields(_r96fa4475bc)\n\n        _rcc62c397b8 = _r96fa4475bc["task"]\n        assert _rcc62c397b8.env_vars[0].name == "bartemplated"\n        assert _rcc62c397b8.env_vars[0].value == "footemplated"\n\n    def test_container_logs_falls_back_to_rendered_base_container_name(self):\n        _r2abd5cd501 = KubernetesPodOperator(\n            task_id="task",\n            base_container_name="{{ container }}",\n            dag=DAG(dag_id="dag", schedule=None, start_date=pendulum.now()),\n        )\n        _r2abd5cd501.render_template_fields(context={"container": "rendered-base"})\n        assert _r2abd5cd501.container_logs == "rendered-base"\n\n    def test_envs_from_secrets(self):\n        _r8b73375800 = "secret_name"\n        _r2bf4364a7d = [Secret("env", None, _r8b73375800)]\n        _r769a4cde6f = KubernetesPodOperator(\n            secrets=_r2bf4364a7d,\n            task_id="test",\n        )\n        _rf2d2c05bf3 = _r769a4cde6f.build_pod_request_obj()\n        assert _rf2d2c05bf3.spec.containers[0].env_from == [\n            k8s.V1EnvFromSource(secret_ref=k8s.V1SecretEnvSource(name=_r8b73375800))\n        ]\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize("in_cluster", (True, False))\n    @patch(HOOK_CLASS)\n    def test_labels(self, hook_mock, in_cluster):\n        hook_mock.return_value.is_in_cluster = in_cluster\n        _rd68df4f619 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            labels={"foo": "bar", "none_value": None},\n            name="test",\n            task_id="task",\n            in_cluster=in_cluster,\n            do_xcom_push=False,\n        )\n        _r4d1567c87f, _r0d05379451 = self.run_pod(_rd68df4f619)\n        assert _r4d1567c87f.metadata.labels == {\n            "foo": "bar",\n            "dag_id": "dag",\n            "kubernetes_pod_operator": "True",\n            "task_id": "task",\n            # Try number behaves differently on different versions of Airflow\n            "try_number": mock.ANY,\n            "airflow_version": mock.ANY,\n            "run_id": "test",\n            "airflow_kpo_in_cluster": str(in_cluster),\n            "none_value": "",  # None converted to empty string\n        }\n\n    def test_labels_mapped(self):\n        _r5b05936b40 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n        )\n        _refffab97d9 = _r5b05936b40.build_pod_request_obj(create_context(_r5b05936b40, map_index=10))\n        assert _refffab97d9.metadata.labels == {\n            "dag_id": "dag",\n            "kubernetes_pod_operator": "True",\n            "task_id": "task",\n            "try_number": mock.ANY,\n            "airflow_version": mock.ANY,\n            "run_id": "test",\n            "map_index": "10",\n            "airflow_kpo_in_cluster": str(_r5b05936b40.hook.is_in_cluster),\n        }\n\n    @patch(HOOK_CLASS)\n    def test_build_pod_request_obj_dry_run_skips_live_kube_client(self, hook_mock):\n        """dry_run must not require a live Kubernetes API client (e.g. no kube config available)."""\n        type(hook_mock.return_value).is_in_cluster = mock.PropertyMock(\n            side_effect=RuntimeError("kube config not available")\n        )\n        _rac6ddbe3d1 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n        )\n        _r47bed6d621 = _rac6ddbe3d1.build_pod_request_obj(dry_run=True)\n        assert "airflow_kpo_in_cluster" not in _r47bed6d621.metadata.labels\n\n        with pytest.raises(RuntimeError, match="kube config not available"):\n            _rac6ddbe3d1.build_pod_request_obj()\n\n    @patch(HOOK_CLASS)\n    def test_dry_run_method_prints_pod_without_live_kube_client(self, hook_mock, capsys):\n        type(hook_mock.return_value).is_in_cluster = mock.PropertyMock(\n            side_effect=RuntimeError("kube config not available")\n        )\n        hook_mock.return_value.get_namespace.return_value = "default"\n        _rf705365cf2 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n        )\n        _rf705365cf2.dry_run()\n\n        assert "kind: Pod" in capsys.readouterr().out\n\n    def test_find_custom_pod_labels(self):\n        _r7186483808 = KubernetesPodOperator(\n            labels={"foo": "bar", "hello": "airflow"},\n            name="test",\n            task_id="task",\n        )\n        _rb8d0be1c5a = create_context(_r7186483808)\n        _ra3ac39682b = _r7186483808._build_find_pod_label_selector(_rb8d0be1c5a)\n        assert "foo=bar" in _ra3ac39682b\n        assert "hello=airflow" in _ra3ac39682b\n\n    def test_build_find_pod_label_selector(self):\n        """Comprehensive single test combining all label normalization scenarios.\n\n        Includes: normal labels, None values, empty string, zero, False.\n        Asserts: None -> empty assignment, other falsy preserved, core airflow labels present, no literal \'None\'.\n        """\n        _r624ea35501 = KubernetesPodOperator(\n            labels={\n                "foo": "bar",\n                "hello": "airflow",\n                "a": None,\n                "c": None,\n                "empty_str": "",\n                "zero": 0,\n                "false": False,\n                "none": None,\n            },\n            name="test",\n            task_id="task",\n        )\n        _r3655472f68 = create_context(_r624ea35501)\n        _r0c94e346fb = _r624ea35501._build_find_pod_label_selector(_r3655472f68)\n\n        # Standard labels\n        assert "foo=bar" in _r0c94e346fb\n        assert "hello=airflow" in _r0c94e346fb\n\n        # None normalization (shows as key= with no value)\n        for _r8752147f88 in ["a", "c", "none"]:\n            assert f"{_r8752147f88}=" in _r0c94e346fb\n\n        # Falsy but non-None values preserved verbatim\n        assert "empty_str=" in _r0c94e346fb\n        assert "zero=0" in _r0c94e346fb\n        assert "false=False" in _r0c94e346fb\n\n        # Core Airflow identifying labels always present\n        for _rb26bb01d09 in ["dag_id=dag", "task_id=task", "kubernetes_pod_operator=True", "run_id=test"]:\n            assert _rb26bb01d09 in _r0c94e346fb\n\n        # Never include literal string \'None\'\n        assert "None" not in _r0c94e346fb\n\n    @pytest.mark.asyncio\n    @patch(HOOK_CLASS, new=MagicMock)\n    def test_find_pod_labels(self):\n        _rc6305aeb6b = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            in_cluster=False,\n            do_xcom_push=False,\n        )\n        self.run_pod(_rc6305aeb6b)\n        _red6705f402, _rc1e3dfe835 = _rc6305aeb6b.client.list_namespaced_pod.call_args\n        assert _rc1e3dfe835["label_selector"] == (\n            "dag_id=dag,foo=bar,kubernetes_pod_operator=True,run_id=test,task_id=task,"\n            "already_checked!=True,!airflow-worker"\n        )\n\n    @patch(HOOK_CLASS, new=MagicMock)\n    def test_pod_dns_options(self):\n        _r01f22fc1b0 = k8s.V1PodDNSConfig(\n            nameservers=["192.0.2.1", "192.0.2.3"],\n            searches=["ns1.svc.cluster-domain.example", "my.dns.search.suffix"],\n            options=[\n                k8s.V1PodDNSConfigOption(\n                    name="ndots",\n                    value="2",\n                )\n            ],\n        )\n        _ra59c8835e7 = "busybox-2"\n        _rc7c9882b27 = "busybox-subdomain"\n\n        _rc855e1ce30 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            in_cluster=False,\n            do_xcom_push=False,\n            dns_config=_r01f22fc1b0,\n            hostname=_ra59c8835e7,\n            subdomain=_rc7c9882b27,\n        )\n\n        self.run_pod(_rc855e1ce30)\n        _rd0e5cbbcf1 = _rc855e1ce30.pod.spec\n        assert _rd0e5cbbcf1.dns_config == _r01f22fc1b0\n        assert _rd0e5cbbcf1.subdomain == _rc7c9882b27\n        assert _rd0e5cbbcf1.hostname == _ra59c8835e7\n\n    @pytest.mark.parametrize(\n        "val",\n        [\n            pytest.param([k8s.V1LocalObjectReference("fakeSecret")], id="current"),\n            pytest.param("fakeSecret", id="backcompat"),\n        ],\n    )\n    def test_image_pull_secrets_correctly_set(self, val):\n        _rd9bc9e49fb = KubernetesPodOperator(\n            task_id="task",\n            image_pull_secrets=val,\n        )\n\n        _re875bc3b88 = _rd9bc9e49fb.build_pod_request_obj(create_context(_rd9bc9e49fb))\n        assert _re875bc3b88.spec.image_pull_secrets == [k8s.V1LocalObjectReference(name="fakeSecret")]\n\n    def test_omitted_name(self):\n        _ra8eab97651 = KubernetesPodOperator(task_id="this-task-name")\n        _recb1e39131 = _ra8eab97651.build_pod_request_obj(create_context(_ra8eab97651))\n        assert re.match("this-task-name-[a-z0-9]+", _recb1e39131.metadata.name) is not None\n\n    @pytest.mark.parametrize("use_template", [True, False])\n    @pytest.mark.parametrize("use_pod_spec", [True, False])\n    @patch("pathlib.Path")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    @patch.dict(\n        "os.environ", AIRFLOW_CONN_MY_CONN=\'{"extra": {"extra__kubernetes__namespace": "extra-namespace"}}\'\n    )\n    def test_omitted_namespace_with_conn(\n        self, mock_find, mock_path, pod_template_file, use_template, pod_spec, use_pod_spec\n    ):\n        """\n        Namespace precedence is as follows:\n            - KPO\n            - airflow connection\n            - infer from k8s when in a cluster\n            - \'default\' namespace as a fallback\n\n        Here we check when KPO omitted but we do have a conn where namespace defined.\n        In this case, the namespace should be as defined in connection.\n        """\n        _r73e9d12ab8 = KubernetesPodOperator(\n            task_id="task",\n            kubernetes_conn_id="my_conn",\n            **(dict(pod_template_file=pod_template_file) if use_template else {}),\n            **(dict(full_pod_spec=pod_spec) if use_pod_spec else {}),\n        )\n        _r30a7606398 = create_context(_r73e9d12ab8)\n        _r98a2048b92 = _r73e9d12ab8.build_pod_request_obj(_r30a7606398)\n        mock_path.assert_not_called()\n        if use_pod_spec:\n            _re654aa6ff4 = "podspecnamespace"\n        elif use_template:\n            _re654aa6ff4 = "templatenamespace"\n        else:\n            _re654aa6ff4 = "extra-namespace"\n        assert _r98a2048b92.metadata.namespace == _re654aa6ff4\n        mock_find.return_value = _r98a2048b92\n        _r73e9d12ab8.get_or_create_pod(\n            pod_request_obj=_r98a2048b92,\n            context=_r30a7606398,\n        )\n        mock_find.assert_called_once_with(_re654aa6ff4, context=_r30a7606398)\n\n    @patch("pathlib.Path")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    @patch.dict("os.environ", AIRFLOW_CONN_MY_CONN=\'{"extra": {}}\')\n    def test_omitted_namespace_with_conn_no_value(self, mock_find, mock_path):\n        """\n        Namespace precedence is as follows:\n            - KPO\n            - airflow connection\n            - infer from k8s when in a cluster\n            - \'default\' namespace as a fallback\n\n        Here we check when KPO omitted but we do have a conn where namespace defined.\n        In this case, we should continue down the change.\n        Here we mock not in k8s and therefore get \'default\'.\n        """\n        _r15500de474 = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n            kubernetes_conn_id="my_conn",\n        )\n\n        mock_path.return_value.exists.return_value = False\n        _r9699be3ace = create_context(_r15500de474)\n        _r4389a57a8e = _r15500de474.build_pod_request_obj(_r9699be3ace)\n        mock_path.assert_called()\n        assert _r4389a57a8e.metadata.namespace == "default"\n        mock_find.return_value = _r4389a57a8e\n        _r15500de474.get_or_create_pod(\n            pod_request_obj=_r4389a57a8e,\n            context=_r9699be3ace,\n        )\n        mock_find.assert_called_once_with("default", context=_r9699be3ace)\n\n    @patch("pathlib.Path")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_omitted_namespace_no_conn(self, mock_find, mock_path):\n        """\n        Namespace precedence is as follows:\n            - KPO\n            - airflow connection\n            - infer from k8s when in a cluster\n            - \'default\' namespace as a fallback\n\n        Here we check when KPO omitted and no airflow connection, but we are in k8s.\n        In this case, we should use the value from k8s.\n        """\n        mock_path.return_value.exists.return_value = True\n        mock_path.return_value.read_text.return_value = "abc"\n        _rb5963a5425 = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n        )\n\n        _r753572a450 = create_context(_rb5963a5425)\n        _r612941aeb6 = _rb5963a5425.build_pod_request_obj(_r753572a450)\n        mock_path.assert_called_once_with("/var/run/secrets/kubernetes.io/serviceaccount/namespace")\n        assert _r612941aeb6.metadata.namespace == "abc"\n        mock_find.return_value = _r612941aeb6\n        _rb5963a5425.get_or_create_pod(\n            pod_request_obj=_r612941aeb6,\n            context=_r753572a450,\n        )\n        mock_find.assert_called_once_with("abc", context=_r753572a450)\n\n    @patch("pathlib.Path")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_omitted_namespace_no_conn_not_in_k8s(self, mock_find, mock_path):\n        """\n        Namespace precedence is as follows:\n            - KPO\n            - airflow connection\n            - infer from k8s when in a cluster\n            - \'default\' namespace as a fallback\n\n        Here we check when KPO omitted and no airflow connection and not in a k8s pod.\n        In this case we should end up with the \'default\' namespace.\n        """\n        mock_path.return_value.exists.return_value = False\n        _rf82e28b173 = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n        )\n\n        _r237e5fdcf6 = create_context(_rf82e28b173)\n        _rc66b7d6c50 = _rf82e28b173.build_pod_request_obj(_r237e5fdcf6)\n        mock_path.assert_called_once_with("/var/run/secrets/kubernetes.io/serviceaccount/namespace")\n        assert _rc66b7d6c50.metadata.namespace == "default"\n        mock_find.return_value = _rc66b7d6c50\n        _rf82e28b173.get_or_create_pod(\n            pod_request_obj=_rc66b7d6c50,\n            context=_r237e5fdcf6,\n        )\n        mock_find.assert_called_once_with("default", context=_r237e5fdcf6)\n\n    @pytest.mark.parametrize(\n        ("on_finish_action", "pod_phase", "should_delete"),\n        [\n            (OnFinishAction.DELETE_POD, PodPhase.PENDING, True),\n            (OnFinishAction.DELETE_POD, PodPhase.RUNNING, True),\n            (OnFinishAction.DELETE_POD, PodPhase.SUCCEEDED, True),\n            (OnFinishAction.DELETE_POD, PodPhase.FAILED, True),\n            (OnFinishAction.DELETE_SUCCEEDED_POD, PodPhase.PENDING, False),\n            (OnFinishAction.DELETE_SUCCEEDED_POD, PodPhase.RUNNING, False),\n            (OnFinishAction.DELETE_SUCCEEDED_POD, PodPhase.SUCCEEDED, True),\n            (OnFinishAction.DELETE_SUCCEEDED_POD, PodPhase.FAILED, False),\n            (OnFinishAction.DELETE_ACTIVE_POD, PodPhase.PENDING, True),\n            (OnFinishAction.DELETE_ACTIVE_POD, PodPhase.RUNNING, True),\n            (OnFinishAction.DELETE_ACTIVE_POD, PodPhase.SUCCEEDED, False),\n            (OnFinishAction.DELETE_ACTIVE_POD, PodPhase.FAILED, False),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    def test_process_pod_deletion(self, delete_pod_mock, on_finish_action, pod_phase, should_delete):\n        """Test KubernetesPodOperator pod cleanup behavior across all modes and pod phases."""\n\n        _r7338d35652 = KubernetesPodOperator(\n            namespace="default",\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            labels={"foo": "bar"},\n            name="test",\n            task_id="task",\n            do_xcom_push=False,\n        )\n\n        _r7338d35652.on_finish_action = on_finish_action\n\n        _r14445e45e9 = MagicMock()\n        _r14445e45e9.metadata.name = "pod-name"\n        _r14445e45e9.status.phase = pod_phase\n\n        _rec49c85a0f = _r7338d35652.process_pod_deletion(_r14445e45e9)\n\n        # Assert deletion side-effect behavior\n        if should_delete:\n            delete_pod_mock.assert_called_once_with(_r14445e45e9)\n        else:\n            delete_pod_mock.assert_not_called()\n\n        assert _rec49c85a0f == should_delete\n\n    @pytest.mark.parametrize(\n        "pod_phase",\n        [\n            PodPhase.SUCCEEDED,\n            PodPhase.FAILED,\n            PodPhase.RUNNING,\n        ],\n    )\n    @patch(f"{KPO_MODULE}.PodManager.create_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.process_pod_deletion")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_get_or_create_pod_reattach_terminated(\n        self, mock_find, mock_process_pod_deletion, mock_create_pod, pod_phase\n    ):\n        """Check that get_or_create_pod reattaches to existing pod."""\n        _r16d33167e1 = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n            log_pod_spec_on_failure=False,\n        )\n        _r16d33167e1.reattach_on_restart = True\n        _re0b62e187d = create_context(_r16d33167e1)\n        _rffc232d110 = MagicMock()\n        _rffc232d110.to_dict.return_value = {"metadata": {"name": "test-pod"}}\n\n        _r84b7c8fc36 = MagicMock()\n        _r84b7c8fc36.status.phase = pod_phase\n        mock_find.return_value = _r84b7c8fc36\n        _refd03b2bf6 = _r16d33167e1.get_or_create_pod(\n            pod_request_obj=_rffc232d110,\n            context=_re0b62e187d,\n        )\n        if pod_phase == PodPhase.RUNNING:\n            mock_create_pod.assert_not_called()\n            mock_process_pod_deletion.assert_not_called()\n            assert _refd03b2bf6 == _r84b7c8fc36\n        else:\n            mock_process_pod_deletion.assert_called_once_with(_r84b7c8fc36)\n            mock_create_pod.assert_called_once_with(pod=_rffc232d110)\n            assert _refd03b2bf6 == _rffc232d110\n\n    @pytest.mark.parametrize(\n        ("pod_phase", "pod_reason", "should_reuse"),\n        [\n            ("Running", "", True),\n            ("Running", "Evicted", False),\n            ("Succeeded", None, False),\n            ("Failed", None, False),\n        ],\n        ids=["running", "evicted", "succeeded", "failed"],\n    )\n    @patch(f"{KPO_MODULE}.PodManager.create_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.process_pod_deletion")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_get_or_create_pod_reattach_with_evicted(\n        self,\n        mock_find,\n        mock_process_pod_deletion,\n        mock_create_pod,\n        pod_phase,\n        pod_reason,\n        should_reuse,\n    ):\n        """Test that get_or_create_pod reattaches or recreates pod based on phase and reason."""\n        _r07f169897e = KubernetesPodOperator(\n            image="ubuntu:16.04",\n            cmds=["bash", "-cx"],\n            arguments=["echo 10"],\n            task_id="task",\n            name="hello",\n            log_pod_spec_on_failure=False,\n        )\n        _r07f169897e.reattach_on_restart = True\n        _r2512a35073 = create_context(_r07f169897e)\n        _r096dfbf73f = MagicMock()\n        _r096dfbf73f.to_dict.return_value = {"metadata": {"name": "test-pod"}}\n\n        _r5d801ea566 = MagicMock()\n        _r5d801ea566.status.phase = pod_phase\n        _r5d801ea566.status.reason = pod_reason\n        mock_find.return_value = _r5d801ea566\n\n        _r84fcfff110 = _r07f169897e.get_or_create_pod(\n            pod_request_obj=_r096dfbf73f,\n            context=_r2512a35073,\n        )\n\n        if should_reuse:\n            mock_create_pod.assert_not_called()\n            mock_process_pod_deletion.assert_not_called()\n            assert _r84fcfff110 == _r5d801ea566\n        else:\n            mock_process_pod_deletion.assert_called_once_with(_r5d801ea566)\n            mock_create_pod.assert_called_once_with(pod=_r096dfbf73f)\n            assert _r84fcfff110 == _r096dfbf73f\n\n    def test_xcom_sidecar_container_image_custom(self):\n        _re23251f236 = "private.repo/alpine:3.24.2"\n        with temp_override_attr(PodDefaults.SIDECAR_CONTAINER, "image", _re23251f236):\n            _r9e44cfa2cd = KubernetesPodOperator(\n                name="test",\n                task_id="task",\n                do_xcom_push=True,\n            )\n            _rb4d1264246 = _r9e44cfa2cd.build_pod_request_obj(create_context(_r9e44cfa2cd))\n        assert _rb4d1264246.spec.containers[1].image == _re23251f236\n\n    def test_xcom_sidecar_container_image_default(self):\n        _re545d70f91 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n        )\n        _r90eadfa539 = _re545d70f91.build_pod_request_obj(create_context(_re545d70f91))\n        assert _r90eadfa539.spec.containers[1].image == "alpine:3.24.2"\n\n    def test_xcom_sidecar_container_resources_default(self):\n        _r167aeb8d6c = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n        )\n        _rb6910cabae = _r167aeb8d6c.build_pod_request_obj(create_context(_r167aeb8d6c))\n        assert _rb6910cabae.spec.containers[1].resources == k8s.V1ResourceRequirements(\n            requests={\n                "cpu": "1m",\n                "memory": "10Mi",\n            },\n        )\n\n    def test_xcom_sidecar_container_resources_custom(self):\n        _r89a4536cf3 = {\n            "requests": {"cpu": "1m", "memory": "10Mi"},\n            "limits": {"cpu": "10m", "memory": "50Mi"},\n        }\n        with temp_override_attr(PodDefaults.SIDECAR_CONTAINER, "resources", _r89a4536cf3):\n            _r97770af810 = KubernetesPodOperator(\n                name="test",\n                task_id="task",\n                do_xcom_push=True,\n            )\n            _r1827095afd = _r97770af810.build_pod_request_obj(create_context(_r97770af810))\n            assert _r1827095afd.spec.containers[1].resources == _r89a4536cf3\n\n    def test_xcom_sidecar_container_security_context_default(self):\n        _r41616f1441 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n        )\n        _rc85ea6c5db = _r41616f1441.build_pod_request_obj(create_context(_r41616f1441))\n        assert _rc85ea6c5db.spec.containers[1].security_context is None\n\n    @patch(f"{HOOK_CLASS}.get_xcom_sidecar_container_security_context")\n    def test_xcom_sidecar_container_security_context_from_connection(self, mock_get_security_context):\n        _rf2becbc092 = {\n            "allowPrivilegeEscalation": False,\n            "readOnlyRootFilesystem": True,\n            "seccompProfile": {"type": "RuntimeDefault"},\n        }\n        mock_get_security_context.return_value = _rf2becbc092\n        _rc79b43885b = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n        )\n        _rffe2be75b2 = _rc79b43885b.build_pod_request_obj(create_context(_rc79b43885b))\n        assert _rffe2be75b2.spec.containers[1].security_context == _rf2becbc092\n\n    @patch(f"{HOOK_CLASS}.get_xcom_sidecar_container_security_context")\n    def test_xcom_sidecar_container_security_context_operator_overrides_connection(\n        self, mock_get_security_context\n    ):\n        mock_get_security_context.return_value = {"readOnlyRootFilesystem": False}\n        _rc61e73af63 = {"readOnlyRootFilesystem": True}\n        _re4230f162a = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n            xcom_sidecar_container_security_context=_rc61e73af63,\n        )\n        _r2f10880e67 = _re4230f162a.build_pod_request_obj(create_context(_re4230f162a))\n        assert _r2f10880e67.spec.containers[1].security_context == _rc61e73af63\n\n    @patch(f"{HOOK_CLASS}.get_xcom_sidecar_container_security_context")\n    def test_xcom_sidecar_container_security_context_empty_operator_overrides_connection(\n        self, mock_get_security_context\n    ):\n        mock_get_security_context.return_value = {"readOnlyRootFilesystem": True}\n        _r1e2cbc30d6 = KubernetesPodOperator(\n            name="test",\n            task_id="task",\n            do_xcom_push=True,\n            xcom_sidecar_container_security_context={},\n        )\n        _r3d2d3d9809 = _r1e2cbc30d6.build_pod_request_obj(create_context(_r1e2cbc30d6))\n        assert _r3d2d3d9809.spec.containers[1].security_context == {}\n\n    def test_image_pull_policy_correctly_set(self):\n        _rc2dde27439 = KubernetesPodOperator(\n            task_id="task",\n            image_pull_policy="Always",\n        )\n        _r9ba7ea271f = _rc2dde27439.build_pod_request_obj(create_context(_rc2dde27439))\n        assert _r9ba7ea271f.spec.containers[0].image_pull_policy == "Always"\n\n    def test_termination_message_policy_correctly_set(self):\n        _re15454f953 = KubernetesPodOperator(\n            task_id="task",\n            termination_message_policy="FallbackToLogsOnError",\n        )\n\n        _rb4f3163374 = _re15454f953.build_pod_request_obj(create_context(_re15454f953))\n        assert _rb4f3163374.spec.containers[0].termination_message_policy == "FallbackToLogsOnError"\n\n    def test_termination_message_policy_default_value_correctly_set(self):\n        _rc97745e7c7 = KubernetesPodOperator(\n            task_id="task",\n        )\n\n        _rcb91a8a329 = _rc97745e7c7.build_pod_request_obj(create_context(_rc97745e7c7))\n        assert _rcb91a8a329.spec.containers[0].termination_message_policy == "File"\n\n    def test_runtime_class_name_correctly_set(self):\n        _r26455ce3f7 = KubernetesPodOperator(\n            task_id="task",\n            runtime_class_name="gvisor",\n        )\n        _rfb309022b6 = _r26455ce3f7.build_pod_request_obj(create_context(_r26455ce3f7))\n        assert _rfb309022b6.spec.runtime_class_name == "gvisor"\n\n    def test_runtime_class_name_default_value_correctly_set(self):\n        _rcb9a52306c = KubernetesPodOperator(\n            task_id="task",\n        )\n        _r7aac7e556b = _rcb9a52306c.build_pod_request_obj(create_context(_rcb9a52306c))\n        assert _r7aac7e556b.spec.runtime_class_name is None\n\n    def test_termination_grace_period_correctly_set(self):\n        _rf1b35a8718 = KubernetesPodOperator(\n            task_id="task",\n            termination_grace_period=300,\n        )\n\n        _r078010ffab = _rf1b35a8718.build_pod_request_obj(create_context(_rf1b35a8718))\n        assert _r078010ffab.spec.termination_grace_period_seconds == 300\n\n    def test_termination_grace_period_default_value_correctly_set(self):\n        _re7c74146d7 = KubernetesPodOperator(\n            task_id="task",\n        )\n\n        _r9e3afec6c3 = _re7c74146d7.build_pod_request_obj(create_context(_re7c74146d7))\n        assert _r9e3afec6c3.spec.termination_grace_period_seconds is None\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize(\n        ("task_kwargs", "base_container_fail", "expect_to_delete_pod"),\n        [\n            ({"on_finish_action": "delete_pod"}, True, True),\n            ({"on_finish_action": "delete_pod"}, False, True),\n            ({"on_finish_action": "keep_pod"}, False, False),\n            ({"on_finish_action": "keep_pod"}, True, False),\n            ({"on_finish_action": "delete_succeeded_pod"}, False, True),\n            ({"on_finish_action": "delete_succeeded_pod"}, True, False),\n            ({"on_finish_action": "delete_active_pod"}, True, True),\n            ({"on_finish_action": "delete_active_pod"}, False, True),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.is_istio_enabled")\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_pod_with_istio_delete_after_await_container_error(\n        self,\n        find_pod_mock,\n        await_pod_completion_mock,\n        is_istio_enabled_mock,\n        delete_pod_mock,\n        task_kwargs,\n        base_container_fail,\n        expect_to_delete_pod,\n    ):\n        """\n        When KPO fails unexpectedly during await_container, we should still try to delete the pod,\n        and the pod we try to delete should be the one returned from find_pod earlier.\n        """\n        _r4060a91ae1 = MagicMock()\n        _r4060a91ae1.name = "istio-proxy"\n        _r4060a91ae1.namespace = "default"\n        _r4060a91ae1.image = "istio/proxyv2:1.18.2"\n        _r4060a91ae1.args = []\n        _r4060a91ae1.state.running = True\n\n        _r705b433568 = MagicMock()\n        _r705b433568.name = "base"\n        _r705b433568.state.running = False\n        _r705b433568.state.terminated.exit_code = 0\n        if base_container_fail:\n            _r705b433568.state.terminated.exit_code = 1\n            _r705b433568.state.terminated.message = "my-failure"\n\n        _r5eb4681ba9 = MagicMock()\n        _r5eb4681ba9.name = "istio-proxy"\n        _r5eb4681ba9.state.running = True\n        _r5eb4681ba9.state.terminated = False\n\n        await_pod_completion_mock.return_value.spec.containers = [_r4060a91ae1, _r705b433568, _r5eb4681ba9]\n        await_pod_completion_mock.return_value.status.phase = "Running"\n        await_pod_completion_mock.return_value.status.container_statuses = [_r705b433568, _r5eb4681ba9]\n        await_pod_completion_mock.return_value.metadata.name = "pod-with-istio-sidecar"\n        await_pod_completion_mock.return_value.metadata.namespace = "default"\n\n        find_pod_mock.return_value.spec.containers = [_r4060a91ae1, _r705b433568, _r5eb4681ba9]\n        find_pod_mock.return_value.status.phase = "Running"\n        find_pod_mock.return_value.status.container_statuses = [_r705b433568, _r5eb4681ba9]\n        find_pod_mock.return_value.metadata.name = "pod-with-istio-sidecar"\n        find_pod_mock.return_value.metadata.namespace = "default"\n\n        _rb05ab65c0d = KubernetesPodOperator(task_id="task", **task_kwargs)\n\n        _r38a1d10d7b = create_context(_rb05ab65c0d)\n        _r38a1d10d7b["ti"].xcom_push = MagicMock()\n\n        if base_container_fail:\n            self.await_pod_mock.side_effect = AirflowException("fake failure")\n            with pytest.raises(AirflowException, match="my-failure"):\n                _rb05ab65c0d.execute(context=_r38a1d10d7b)\n        else:\n            _rb05ab65c0d.execute(context=_r38a1d10d7b)\n\n        if expect_to_delete_pod:\n            assert _rb05ab65c0d.is_istio_enabled(find_pod_mock.return_value)\n            delete_pod_mock.assert_called_with(await_pod_completion_mock.return_value)\n        else:\n            delete_pod_mock.assert_not_called()\n\n    @pytest.mark.parametrize(\n        ("base_container_exit_code", "expect_failure"),\n        [\n            pytest.param(0, False, id="base-succeeded"),\n            pytest.param(1, True, id="base-failed"),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.extract_xcom")\n    @patch(f"{POD_MANAGER_CLASS}.await_xcom_sidecar_container_start")\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_cleanup_with_xcom_sidecar_uses_base_container_status(\n        self,\n        find_pod_mock,\n        await_pod_completion_mock,\n        delete_pod_mock,\n        mock_await_xcom_sidecar,\n        mock_extract_xcom,\n        base_container_exit_code,\n        expect_failure,\n    ):\n        """\n        When do_xcom_push=True, cleanup should determine success/failure based on\n        the base container\'s exit status, not the pod phase. The xcom sidecar may\n        keep the pod in Running phase after the base container completes.\n        """\n        mock_extract_xcom.return_value = "{}"\n        mock_await_xcom_sidecar.return_value = None\n\n        _re5b063ec6d = MagicMock()\n        _re5b063ec6d.name = "base"\n        _re5b063ec6d.state.terminated.exit_code = base_container_exit_code\n        _re5b063ec6d.state.terminated.message = "task failed" if base_container_exit_code else None\n\n        _rd0f0bf7872 = MagicMock()\n        _rd0f0bf7872.name = "airflow-xcom-sidecar"\n        _rd0f0bf7872.state.running = True\n        _rd0f0bf7872.state.terminated = None\n\n        # Pod is still Running because xcom sidecar is alive\n        _ra482d3e50f = MagicMock()\n        _ra482d3e50f.status.phase = "Running"\n        _ra482d3e50f.status.container_statuses = [_re5b063ec6d, _rd0f0bf7872]\n        _ra482d3e50f.metadata.name = "pod-with-xcom-sidecar"\n        _ra482d3e50f.metadata.namespace = "default"\n        _ra482d3e50f.spec.containers = [MagicMock(), MagicMock()]\n\n        await_pod_completion_mock.return_value = _ra482d3e50f\n        find_pod_mock.return_value = _ra482d3e50f\n\n        _r3c1c5196a9 = KubernetesPodOperator(\n            task_id="task",\n            do_xcom_push=True,\n        )\n\n        _r05a890f07f = create_context(_r3c1c5196a9)\n        _r05a890f07f["ti"].xcom_push = MagicMock()\n\n        if expect_failure:\n            with pytest.raises(AirflowException, match="task failed"):\n                _r3c1c5196a9.execute(context=_r05a890f07f)\n        else:\n            _r3c1c5196a9.execute(context=_r05a890f07f)\n\n    @pytest.mark.parametrize(\n        ("task_kwargs", "should_be_deleted"),\n        [\n            pytest.param({}, True, id="default"),  # default values\n            pytest.param({"on_finish_action": "delete_pod"}, True, id="delete-pod"),\n            pytest.param({"on_finish_action": "delete_succeeded_pod"}, False, id="delete-succeeded-pod"),\n            pytest.param({"on_finish_action": "keep_pod"}, False, id="keep-pod"),\n            pytest.param({"on_finish_action": "delete_active_pod"}, False, id="delete-active-pod"),\n        ],\n    )\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    def test_pod_delete_after_await_container_error(\n        self, find_pod_mock, delete_pod_mock, task_kwargs, should_be_deleted\n    ):\n        """\n        When KPO fails unexpectedly during await_container, we should still try to delete the pod,\n        and the pod we try to delete should be the one returned from find_pod earlier.\n        """\n        _re065e74633 = MagicMock()\n        _re065e74633.name = "base"\n        _re065e74633.state.terminated.message = "my-failure"\n        find_pod_mock.return_value.status.container_statuses = [_re065e74633]\n        _rbff046b2b5 = KubernetesPodOperator(task_id="task", **task_kwargs)\n        self.await_pod_mock.side_effect = AirflowException("fake failure")\n        _ree09134b3b = create_context(_rbff046b2b5)\n        _ree09134b3b["ti"].xcom_push = MagicMock()\n        with pytest.raises(AirflowException, match="my-failure"):\n            _rbff046b2b5.execute(context=_ree09134b3b)\n        if should_be_deleted:\n            delete_pod_mock.assert_called_with(find_pod_mock.return_value)\n        else:\n            delete_pod_mock.assert_not_called()\n\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.find_pod")\n    @patch(f"{KPO_MODULE}.KubernetesPodOperator.await_init_containers_completion")\n    def test_execute_sync_checks_pod_start_before_following_init_container_logs(\n        self, await_init_mock, find_pod_mock, delete_pod_mock\n    ):\n        """Pod start is awaited before following init-container logs, so a Pending pod hits the\n        startup timeout instead of blocking forever in the init-log wait loop."""\n        find_pod_mock.return_value.status.phase = PodPhase.SUCCEEDED\n        self.await_start_mock.side_effect = PodLaunchTimeoutException("Pod took too long to start")\n        _rf348a1a494 = KubernetesPodOperator(task_id="task", init_container_logs=["init-container"])\n        _r9c84b4f9c4 = create_context(_rf348a1a494)\n        _r9c84b4f9c4["ti"].xcom_push = MagicMock()\n\n        with pytest.raises(PodLaunchTimeoutException, match="too long to start"):\n            _rf348a1a494.execute(context=_r9c84b4f9c4)\n\n        await_init_mock.assert_not_called()\n\n    @pytest.mark.asyncio\n    @pytest.mark.parametrize("should_fail", [True, False])\n    @patch(f"{POD_MANAGER_CLASS}.delete_pod")\n    @patch(f"{POD_MANAGER_CLASS}.await_pod_completion")\n    def test_pod_delete_not_called_when_creation_fails(self, await_pod_mock, delete_pod_mock, should_fail):\n        """\n        When pod creation fails, we never get a read of the remote pod.  In this case we don\'t attempt\n        to delete the pod.\n        """\n        _r424e580cdc = KubernetesPodOperator(\n            task_id="task",\n            on_finish_action="delete_pod",\n        )\n\n        if should_fail:\n            self.create_mock.side_effect = AirflowException("fake failure")\n        else:\n            await_pod_mock.return_value.status.phase = "Succeeded"\n\n        _r9c0ed3d660 = pytest.raises(AirflowException) if should_fail else nullcontext()\n        with _r9c0ed3d660:\n            self.run_pod(_r424e580cdc)\n\n        if should_fail:\n            delete_pod_mock.assert_not_called()\n        else:\n            delete_pod_mock.assert_called()\n\n    @pytest.mark.parametrize("randomize", [True, False])\n    def test_provided_pod_name(self, randomize):\n        _r06b9a7fb22 = "test"\n        _r42699cbc9b = KubernetesPodOperator(\n            name=_r06b9a7fb22,\n            random_name_suffix=randomize,\n            task_id="task",\n        )\n        _r4e9da62821 = create_context(_r42699cbc9b)\n        _ra196c9c22c = _r42699cbc9b.build_pod_request_obj(_r4e9da62821)\n\n        if randomize:\n            assert _ra196c9c22c.metadata.name.startswith(_r06b9a7fb22)\n            assert _ra196c9c22c.metadata.name != _r06b9a7fb22\n        else:\n            assert _ra196c9c22c.metadata.name == _r06b9a7fb22\n\n    @pytest.fixture\n    def pod_spec(self):\n        return k8s.V1Pod(\n            metadata=k8s.V1ObjectMeta(name="hello", labels={"foo": "bar"}, namespace="podspecnamespace"),\n            spec=k8s.V1PodSpec(\n                containers=[\n                    k8s.V1Container(\n                        name="base",\n                        image="ubuntu:16.04",\n                        command=["something"],\n                    )\n                ]\n            ),\n        )\n\n    @pytest.mark.parametrize("randomize_name", (True, False))\n    def test_full_pod_spec(self, randomize_name, pod_spec):\n        _re174656573 = pod_spec.metadata.name\n\n        _r29a72259ee = KubernetesPodOperator(\n            task_id="task",\n            random_name_suffix=randomize_name,\n            full_pod_spec=pod_spec,\n        )\n        _r49f95c0836 = create_context(_r29a72259ee)\n        _r483b8fd006 = _r29a72259ee.build_pod_request_obj(_r49f95c0836)\n\n        if randomize_name:\n            assert _r483b8fd006.metadata.name.startswith(_re174656573)\n            assert _r483b8fd006.metadata.name != _re174656573\n        else:\n            assert _r483b8fd006.metadata.name == _re174656573\n        assert _r483b8fd006.metadata.namespace == pod_spec.metadata.namespace\n        assert _r483b8fd006.spec.containers[0].image == pod_spec.spec.containers[0].image\n        assert _r483b8fd006.spec.containers[0].command == pod_spec.spec.containers[0].command\n        # Check labels are added from pod_template_file and\n        # the pod identifying labels including Airflow version\n        assert _r483b8fd006.metadata.labels == {\n            "foo": "bar",\n            "dag_id": "dag",\n           