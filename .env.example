# Placeholders only. Knack does not read this file: export these in your shell,
# or put each in its ~/.knack file (see README, "Muse Code setup").
# None is needed to install, run `bash scripts/reproduce.sh`, or open the console.
# Spark key (api.meta.ai): ~/.knack/model_api_key
MODEL_API_KEY=<your-spark-key>
# Spark Open key (Baseten): ~/.knack/baseten_api_key
BASETEN_API_KEY=<your-baseten-key>
# Read-only GitHub token: ~/.knack/github_token
GITHUB_TOKEN=<your-github-read-only-token>
